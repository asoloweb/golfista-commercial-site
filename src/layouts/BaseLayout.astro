---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

export interface Props {
	title: string;
	seoTitle?: string;
	seoDescription?: string;
	canonicalPath?: string;
	noindex?: boolean;
	appendSiteName?: boolean;
	/** Colore della barra di Safari e dello sfondo di rimbalzo: deve coincidere con la parte alta della pagina. */
	topColor?: string;
}

const { title, seoTitle, seoDescription, canonicalPath, noindex = false, appendSiteName = true, topColor = '#ffffff' } = Astro.props;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://www.golfista.app').replace(/\/+$/, '');
const organizationSameAs = (import.meta.env.PUBLIC_ORGANIZATION_SAME_AS || '')
	.split(',')
	.map((entry) => entry.trim())
	.filter(Boolean);
const umamiScriptSrc = import.meta.env.PUBLIC_UMAMI_SCRIPT_SRC || 'https://umami.asoloweb.it/script.js';
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || 'b3cc9fb1-46cb-44a9-9a6f-b4c23126b713';
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID || '';

const faviconSrc = '/golfista/app-icon.png';
const logoLightSrc = '/golfista/logo-dark.svg';
const siteName = 'Golfista';
const organizationEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'info@golfista.app';
const organizationPhone = import.meta.env.PUBLIC_CONTACT_PHONE || '+39 338 1164785';
const organizationStreetAddress = 'Via Cime 15, 31020 San Zenone degli Ezzelini (TV), Italia';

const rawTitle = seoTitle?.trim() || title?.trim() || 'App e gestionale per circoli golf';
const resolvedTitle = !appendSiteName || /\bgolfista\b/i.test(rawTitle) ? rawTitle : `${rawTitle} | ${siteName}`;
const rawDescription = typeof seoDescription === 'string' ? seoDescription.replace(/\s+/g, ' ').trim() : '';
const isGenericDescription = /^la home page di golfista\.?$/i.test(rawDescription);
const resolvedDescription =
	rawDescription.length > 0 && !isGenericDescription
		? rawDescription
		: `${rawTitle}: informazioni sulla piattaforma Golfista per giocatori e circoli golf.`;

const absoluteLogoUrl = (() => {
	try {
		return new URL(logoLightSrc, siteUrl).toString();
	} catch {
		return logoLightSrc;
	}
})();
const absoluteSocialImageUrl = new URL('/images/golf/golf-course-sunset.jpg', siteUrl).toString();

function getFaviconMimeType(src: string) {
	const cleanedSrc = src.split('?')[0].split('#')[0].toLowerCase();
	if (cleanedSrc.endsWith('.svg')) return 'image/svg+xml';
	if (cleanedSrc.endsWith('.png')) return 'image/png';
	if (cleanedSrc.endsWith('.webp')) return 'image/webp';
	if (cleanedSrc.endsWith('.jpg') || cleanedSrc.endsWith('.jpeg')) return 'image/jpeg';
	if (cleanedSrc.endsWith('.ico')) return 'image/x-icon';
	return undefined;
}

const faviconMimeType = getFaviconMimeType(faviconSrc);
const canonicalUrl = (() => {
	const path = canonicalPath || Astro.url?.pathname || '/';
	try {
		return new URL(path, siteUrl).toString();
	} catch {
		return siteUrl;
	}
})();

const organizationId = `${siteUrl}/#organization`;
const legalServiceId = `${siteUrl}/#legalservice`;
const organizationJsonLd = JSON.stringify(
	{
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'Organization',
				'@id': organizationId,
				name: siteName,
				url: siteUrl,
				logo: absoluteLogoUrl,
				...(organizationEmail ? { email: organizationEmail } : {}),
				...(organizationPhone ? { telephone: organizationPhone } : {}),
				sameAs: organizationSameAs,
			},
			{
				'@type': 'WebSite',
				'@id': legalServiceId,
				name: siteName,
				url: siteUrl,
				image: absoluteLogoUrl,
				...(organizationPhone ? { telephone: organizationPhone } : {}),
				...(organizationEmail ? { email: organizationEmail } : {}),
				...(organizationStreetAddress
					? { address: { '@type': 'PostalAddress', streetAddress: organizationStreetAddress } }
					: {}),
			},
		],
	},
	null,
	2
);
---

<html lang="it" style={`background-color: ${topColor}`}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type={faviconMimeType} href={faviconSrc} sizes="any" />
		<link rel="shortcut icon" type={faviconMimeType} href={faviconSrc} />
		<link rel="apple-touch-icon" href={faviconSrc} />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content={topColor} />
		<meta name="apple-mobile-web-app-status-bar-style" content="black" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="it-IT" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
		<title>{resolvedTitle}</title>
		<meta name="description" content={resolvedDescription} />
		<meta name="author" content={siteName} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={resolvedTitle} />
		<meta property="og:description" content={resolvedDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={absoluteSocialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={resolvedTitle} />
		<meta name="twitter:description" content={resolvedDescription} />
		<meta name="twitter:image" content={absoluteSocialImageUrl} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
		<meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
		<script type="application/ld+json" set:html={organizationJsonLd}></script>
		<link rel="stylesheet" href="/vendor/aos.css" />
		<link rel="stylesheet" href="/vendor/swiper-bundle.min.css" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
	</head>
	<body style={`background-color: ${topColor}`}>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<CookieBanner
			umamiScriptSrc={umamiScriptSrc}
			umamiWebsiteId={umamiWebsiteId}
			googleAdsId={googleAdsId}
		/>
		<script defer src="/vendor/aos.js"></script>
		<script defer src="/scripts/aos-init.js"></script>
		<script defer src="/scripts/swiper-init.js"></script>
		<script>
			document.addEventListener('click', (event) => {
				const target = event.target;
				if (!(target instanceof Element)) return;

				const telLink = target.closest('a[href^="tel:"]');
				if (telLink instanceof HTMLAnchorElement && typeof window.gtag === 'function') {
					window.gtag('event', 'click_to_call', {
						contact_type: 'phone',
						link_target: telLink.getAttribute('href') || '',
					});
					return;
				}

				const mailtoLink = target.closest('a[href^="mailto:"]');
				if (mailtoLink instanceof HTMLAnchorElement && typeof window.gtag === 'function') {
					window.gtag('event', 'click_to_email', {
						contact_type: 'email',
						link_target: mailtoLink.getAttribute('href') || '',
					});
				}
			});
		</script>
		<slot name="scripts" />
	</body>
</html>
