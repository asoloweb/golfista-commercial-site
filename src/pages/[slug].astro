---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContent from '../components/PageContent.astro';
import { getStaticPage, staticPages } from '../data/site';

export function getStaticPaths() {
	return staticPages.filter((page) => page.slug !== 'home').map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

export const prerender = true;

const routeSlug = String(Astro.params.slug || '').trim();
const page = Astro.props.page || getStaticPage(routeSlug);

if (!page) {
	Astro.response.status = 404;
}

const fallbackTitle = routeSlug ? `Pagina non trovata: ${routeSlug}` : 'Pagina non trovata';
---

<BaseLayout
	title={page?.title || page?.Titolo || fallbackTitle}
	seoTitle={page?.seo_title}
	seoDescription={page ? page.seo_desc?.trim() || page.description : 'La pagina richiesta non esiste o non è disponibile. Consulta le sezioni di Golfista dal menu di navigazione.'}
	noindex={!page}
>
	<PageContent page={page} />
</BaseLayout>
