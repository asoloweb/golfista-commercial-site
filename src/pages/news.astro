---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

export const prerender = true;

const title = 'News';
const description = 'La sezione news di Golfista dedicata al golf e alla piattaforma. I nuovi contenuti sono in preparazione: torna a consultare gli aggiornamenti.';
---

<BaseLayout title={title} seoTitle="News sul golf | Golfista" seoDescription={description}>
	<PageHero title="News" highlight="e approfondimenti" description="Notizie, consigli e aggiornamenti dal mondo del golf." />
	<section class="news_section">
		<div class="news_section_inner">
			<div class="news_empty">
				<i class="fa-regular fa-newspaper" aria-hidden="true"></i>
				<p>Stiamo preparando nuovi contenuti. Torna presto a trovarci.</p>
				<a class="news_button" href="/circoli">Scopri i circoli golf</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.news_section { width: 100%; margin: 0; padding: 64px 0 90px; }
	.news_section_inner { width: min(1240px, calc(100% - 40px)); margin: 0 auto; }
	.news_empty { display: grid; justify-items: center; gap: 24px; padding: 64px 28px; border: 1px solid rgba(14,14,15,.1); border-radius: 30px; background: #fbf7f5; text-align: center; }
	.news_empty > i { color: #00ec10; font-size: 42px; }
	.news_empty p { max-width: 480px; margin: 0; color: #5d5d63; font-size: 15px; line-height: 1.7; }
	.news_button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; max-width: 100%; padding: 14px 24px; border-radius: 999px; background: #000; color: #fff; font-size: 14px; font-weight: 600; }
	.news_button:hover { background: #00ec10; color: #000; }
	.news_button:focus-visible { outline: 3px solid #000; outline-offset: 4px; }
	@media (max-width: 640px) { .news_section { padding: 40px 0 60px; } .news_section_inner { width: calc(100% - 28px); } .news_empty { padding: 44px 24px; } }
</style>
