---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeLanding from '../components/HomeLanding.astro';
import { getStaticPage } from '../data/site';

export const prerender = true;

const page = getStaticPage('home')!;
---

<BaseLayout
	title={page.title}
	seoTitle={page.seo_title}
	seoDescription={page.seo_desc}
	topColor="#0E0E0F"
>
	<HomeLanding />
</BaseLayout>
