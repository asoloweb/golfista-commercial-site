---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QRCode from 'qrcode';
import { assertSupabasePublicConfig, circoloIdFromSlug, circoloSlug, fetchCircoloById, fetchCircoli } from '../../lib/supabase';

export const prerender = true;

export async function getStaticPaths() {
	assertSupabasePublicConfig();
	const circoli = await fetchCircoli();
	return circoli.map((circolo) => ({ params: { slug: circoloSlug(circolo) }, props: { circolo } }));
}

const routeSlug = String(Astro.params.slug || '').trim();
const circoloId = circoloIdFromSlug(routeSlug);
const circolo = Astro.props.circolo || (circoloId ? await fetchCircoloById(circoloId) : null);

if (!circolo) {
	Astro.response.status = 404;
}

const title = circolo?.nomecircolo || 'Circolo non trovato';
const seoName = circolo?.nomecircolo?.trim() || (circolo ? `Circolo golf ${circolo.idcircolo}` : 'Circolo non trovato');
const seoLocation = [circolo?.paese?.trim(), circolo?.provincia?.trim()].filter(Boolean).join(', ');
const seoTitle = seoLocation ? `${seoName} - ${seoLocation}` : seoName;
const description = circolo
	? `Consulta la scheda di ${seoName}${seoLocation ? ` (${seoLocation})` : ''} su Golfista: informazioni e recapiti disponibili del circolo.`
	: 'Il circolo richiesto non esiste o non è disponibile. Consulta l’elenco dei circoli golf presenti su Golfista.';
const mapHref =
	circolo?.lat && circolo?.lon
		? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${circolo.lat},${circolo.lon}`)}`
		: '';
const coverImage = circolo?.local_cover_url || circolo?.cover_image_url || circolo?.cover_url || circolo?.logo_url || '';
const logoImage = circolo?.local_logo_url || circolo?.logo_url || '/loghi/fallback.jpg';

const latNum = Number(circolo?.lat);
const lonNum = Number(circolo?.lon);
const hasCoords = Number.isFinite(latNum) && Number.isFinite(lonNum) && !(latNum === 0 && lonNum === 0);
const downloadQr = await QRCode.toString('https://golfista.app/download', {
	type: 'svg',
	margin: 0,
	errorCorrectionLevel: 'M',
	color: { dark: '#0E0E0F', light: '#FFFFFF' },
});

const details = circolo
	? [
			['Indirizzo', circolo.indirizzo],
			['Località', [circolo.paese, circolo.provincia].filter(Boolean).join(' · ')],
			['Telefono', circolo.telefono],
			['Email', circolo.mail],
			['Segretario', circolo.segretario],
		].filter(([, value]) => Boolean(value))
	: [];
---

<BaseLayout
	title={title}
	seoTitle={seoTitle}
	seoDescription={description}
	canonicalPath={routeSlug ? `/circoli/${routeSlug}` : '/circoli'}
	noindex={!circolo}
>
	{circolo ? (
		<>
			<section class="club_detail_hero">
				<div class="club_hero_inner">
				<a href="/circoli" class="back_link"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Tutti i circoli</a>
				<div class="club_cover_frame">
				{coverImage && (
					<img
						src={coverImage}
						alt={title}
						class="club_cover"
						fetchpriority="high"
						data-fallback-one={`/circoli/${circolo.idcircolo}.1.jpg`}
						data-fallback-two={`/circoli/${circolo.idcircolo}.2.jpg`}
						onerror="if(!this.dataset.triedOne){this.dataset.triedOne='1';this.src=this.dataset.fallbackOne;}else if(!this.dataset.triedTwo){this.dataset.triedTwo='1';this.src=this.dataset.fallbackTwo;}else{this.style.display='none';}"
					/>
				)}
				</div>
				<div class="club_detail_overlay">
					<div class="club_identity">
						<img
							src={logoImage}
							alt={`Logo ${title}`}
							class="club_logo"
							onerror="this.onerror=null;this.src='/loghi/fallback.jpg';"
						/>
						<div>
							<p class="eyebrow">Circolo golf</p>
							<h1>{title}</h1>
							{(circolo.paese || circolo.provincia) && (
								<p>{[circolo.paese, circolo.provincia].filter(Boolean).join(' · ')}</p>
							)}
						</div>
					</div>
				</div>
				</div>
			</section>

			<section class="club_detail_body">
				<div class="club_detail_grid">
					<div class="club_main">
					<article class="club_description">
						<h2>Informazioni</h2>
						{circolo.desc_ai ? (
							<div class="rich_text">
								{circolo.desc_ai.split('\n').filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
							</div>
						) : (
							<p>Non è ancora disponibile una descrizione per questo circolo.</p>
						)}
					</article>

						{hasCoords && (
						<div class="club_weather" data-weather data-lat={latNum} data-lon={lonNum}>
						<div class="weather_head">
							<div>
								<p class="eyebrow eyebrow_inline"><span class="live_dot"></span> Meteo in tempo reale</p>
								<h2>Com’è il tempo al circolo</h2>
							</div>
							<p class="weather_updated" data-w="updated"></p>
						</div>

						<div class="weather_loading" data-w="loading">Caricamento del meteo…</div>

						<div class="weather_body" data-w="body" hidden>
							<div class="weather_now">
								<i class="fa-solid fa-sun weather_icon" data-w="icon" aria-hidden="true"></i>
								<div>
									<p class="weather_temp"><span data-w="temp"></span>°</p>
									<p class="weather_desc" data-w="desc"></p>
									<p class="weather_golf" data-w="golf"></p>
								</div>
							</div>

							<dl class="weather_stats">
								<div><dt><i class="fa-solid fa-temperature-half" aria-hidden="true"></i> Percepita</dt><dd><span data-w="feels"></span>°</dd></div>
								<div><dt><i class="fa-solid fa-wind" aria-hidden="true"></i> Vento</dt><dd><span data-w="wind"></span> km/h <span data-w="windDir"></span></dd></div>
								<div><dt><i class="fa-solid fa-droplet" aria-hidden="true"></i> Umidità</dt><dd><span data-w="humidity"></span>%</dd></div>
								<div><dt><i class="fa-solid fa-umbrella" aria-hidden="true"></i> Pioggia oggi</dt><dd><span data-w="rainProb"></span>%</dd></div>
								<div><dt><i class="fa-solid fa-sun" aria-hidden="true"></i> Alba</dt><dd data-w="sunrise"></dd></div>
								<div><dt><i class="fa-solid fa-moon" aria-hidden="true"></i> Tramonto</dt><dd data-w="sunset"></dd></div>
							</dl>

							<div class="weather_days" data-w="days"></div>
						</div>

						<p class="weather_error" data-w="error" hidden>Meteo al momento non disponibile.</p>
					</div>
						)}
					</div>

					<aside class="club_sidebar">
						<h2>Dettagli</h2>
						<dl>
							{details.map(([label, value]) => (
								<div>
									<dt>{label}</dt>
									<dd>{value}</dd>
								</div>
							))}
						</dl>

						<div class="club_actions">
							{circolo.website && (
								<a href={circolo.website} target="_blank" rel="noopener noreferrer" class="primary_button">
									Sito web
								</a>
							)}
							{circolo.mail && <a href={`mailto:${circolo.mail}`} class="secondary_button">Invia email</a>}
							{circolo.telefono && <a href={`tel:${circolo.telefono.replace(/\s+/g, '')}`} class="secondary_button">Chiama</a>}
							{mapHref && <a href={mapHref} target="_blank" rel="noopener noreferrer" class="secondary_button">Apri mappa</a>}
						</div>
					</aside>
				</div>
			</section>

			<section class="club_app_section">
				<div class="club_app">
					<div class="club_app_copy">
						<p class="eyebrow eyebrow_dark"><span class="live_dot"></span> App gratuita</p>
						<h2>Vuoi vedere tutte le gare di <span class="club_app_mark">{title}</span>?</h2>
						<p>Nell’app Golfista trovi le gare di oggi e le prossime, le condizioni del campo, le foto, le recensioni dei golfisti e le news di questo circolo. Scaricala gratis per iPhone e Android.</p>
						<a href="/download" class="primary_button club_app_button">Scarica l’app <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
					</div>
					<a class="club_app_qr" href="/download" aria-label="QR code per scaricare l'app Golfista">
						<span class="club_app_qr_code" set:html={downloadQr}></span>
						<span>Inquadra con la fotocamera<br />per scaricare l’app</span>
					</a>
				</div>
			</section>
		</>
	) : (
		<section class="club_not_found">
			<h1>Circolo non trovato</h1>
			<p>Il circolo richiesto non esiste o non è disponibile.</p>
			<a href="/circoli" class="primary_button">Torna ai circoli</a>
		</section>
	)}
</BaseLayout>

<script>
	const WEATHER: Record<number, [string, string, string]> = {
		0: ['fa-sun', 'Cielo sereno', 'Giornata perfetta per il golf!'],
		1: ['fa-sun', 'Prevalentemente sereno', 'Ottime condizioni per giocare'],
		2: ['fa-cloud-sun', 'Parzialmente nuvoloso', 'Buone condizioni generali'],
		3: ['fa-cloud', 'Coperto', 'Condizioni accettabili, cielo grigio'],
		45: ['fa-smog', 'Nebbia', 'Attenzione alla visibilità ridotta'],
		48: ['fa-smog', 'Nebbia con brina', 'Campo scivoloso, attenzione'],
		51: ['fa-cloud-rain', 'Pioggerella leggera', 'Portati l’ombrello'],
		53: ['fa-cloud-rain', 'Pioggerella moderata', 'Pioggia fastidiosa ma giocabile'],
		55: ['fa-cloud-showers-heavy', 'Pioggerella intensa', 'Meglio restare al coperto'],
		56: ['fa-cloud-rain', 'Pioggerella gelata leggera', 'Attenzione al ghiaccio'],
		57: ['fa-cloud-rain', 'Pioggerella gelata intensa', 'Campo scivoloso, attenzione'],
		61: ['fa-cloud-rain', 'Pioggia leggera', 'Un po’ d’acqua, ma si può giocare'],
		63: ['fa-cloud-rain', 'Pioggia moderata', 'Campo bagnato, difficile giocare'],
		65: ['fa-cloud-showers-heavy', 'Pioggia forte', 'Meglio restare al coperto'],
		66: ['fa-cloud-rain', 'Pioggia gelata leggera', 'Attenzione al ghiaccio'],
		67: ['fa-cloud-showers-heavy', 'Pioggia gelata intensa', 'Meglio restare al coperto'],
		71: ['fa-snowflake', 'Neve leggera', 'Oggi meglio lo sci'],
		73: ['fa-snowflake', 'Neve moderata', 'Campo innevato, impossibile giocare'],
		75: ['fa-snowflake', 'Neve intensa', 'Bufera di neve, rimandiamo!'],
		77: ['fa-snowflake', 'Nevischio', 'Campo scivoloso, attenzione'],
		80: ['fa-cloud-sun-rain', 'Rovesci leggeri', 'Qualche scroscio, ma si può fare'],
		81: ['fa-cloud-showers-heavy', 'Rovesci moderati', 'Difficile con questi rovesci'],
		82: ['fa-cloud-bolt', 'Rovesci violenti', 'Impossibile giocare'],
		85: ['fa-snowflake', 'Rovesci di neve leggeri', 'Attenzione al campo innevato'],
		86: ['fa-snowflake', 'Rovesci di neve intensi', 'Meglio restare al coperto'],
		95: ['fa-cloud-bolt', 'Temporale', 'Pericoloso, meglio restare al sicuro'],
		96: ['fa-cloud-bolt', 'Temporale con grandine leggera', 'Troppo pericoloso oggi'],
		99: ['fa-cloud-bolt', 'Temporale con grandine forte', 'Assolutamente no, è troppo pericoloso'],
	};
	const info = (code: number) => WEATHER[code] || ['fa-cloud', 'Meteo non disponibile', ''];
	const DIRS = ['N', 'NE', 'E', 'SE', 'S', 'SO', 'O', 'NO'];
	const time = (iso: string) => iso.slice(11, 16);

	async function loadWeather(box: HTMLElement) {
		const el = (key: string) => box.querySelector<HTMLElement>(`[data-w="${key}"]`)!;
		const set = (key: string, value: string | number) => (el(key).textContent = String(value));
		try {
			const url = new URL('https://api.open-meteo.com/v1/forecast');
			url.search = new URLSearchParams({
				latitude: box.dataset.lat!,
				longitude: box.dataset.lon!,
				current: 'temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m,wind_direction_10m',
				daily: 'weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset',
				timezone: 'auto',
				forecast_days: '4',
			}).toString();
			const response = await fetch(url);
			if (!response.ok) throw new Error(String(response.status));
			const data = await response.json();
			const c = data.current;
			const d = data.daily;
			const [icon, desc, golf] = info(c.weather_code);
			el('icon').className = `fa-solid ${icon} weather_icon`;
			set('temp', Math.round(c.temperature_2m));
			set('desc', desc);
			set('golf', golf);
			set('feels', Math.round(c.apparent_temperature));
			set('wind', Math.round(c.wind_speed_10m));
			set('windDir', DIRS[Math.round(c.wind_direction_10m / 45) % 8]);
			set('humidity', Math.round(c.relative_humidity_2m));
			set('rainProb', d.precipitation_probability_max?.[0] ?? 0);
			set('sunrise', time(d.sunrise[0]));
			set('sunset', time(d.sunset[0]));
			set('updated', `Aggiornato alle ${time(c.time)}`);
			el('days').innerHTML = d.time
				.map((day: string, i: number) => {
					const [dIcon, dDesc] = info(d.weather_code[i]);
					const label = i === 0 ? 'Oggi' : new Date(`${day}T12:00:00`).toLocaleDateString('it-IT', { weekday: 'long' });
					return `<div class="weather_day"><p>${label}</p><i class="fa-solid ${dIcon}" title="${dDesc}" aria-hidden="true"></i><span class="sr-only">${dDesc}</span><p><strong>${Math.round(d.temperature_2m_max[i])}°</strong> ${Math.round(d.temperature_2m_min[i])}°</p></div>`;
				})
				.join('');
			el('loading').hidden = true;
			el('body').hidden = false;
		} catch {
			el('loading').hidden = true;
			el('error').hidden = false;
		}
	}

	document.querySelectorAll<HTMLElement>('[data-weather]').forEach(loadWeather);
</script>

<style>
	.club_detail_hero {
		padding: 36px 20px 0;
		background: var(--lex-cream, #ddd);
		color: #0e0e0f;
	}

	.club_hero_inner {
		max-width: 1240px;
		margin: 0 auto;
	}

	.club_cover_frame {
		margin-top: 28px;
		aspect-ratio: 3 / 1;
		border: 1px solid rgba(14, 14, 15, 0.1);
		border-radius: 30px;
		overflow: hidden;
		background: #0e0e0f;
	}

	.club_cover {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.club_detail_overlay {
		padding: 36px 0 0;
	}

	.back_link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 10px 16px;
		border: 1px solid rgba(14, 14, 15, 0.1);
		border-radius: 999px;
		background: #fbf7f5;
		font-size: 13px;
		font-weight: 500;
		text-decoration: none;
	}

	.club_identity {
		display: flex;
		align-items: center;
		gap: 24px;
		overflow-wrap: anywhere;
	}

	.club_identity > div {
		min-width: 0;
	}

	.club_logo {
		flex-shrink: 0;
		width: 110px;
		height: 110px;
		object-fit: contain;
		border: 1px solid rgba(14, 14, 15, 0.1);
		border-radius: 30px;
		background: #fbf7f5;
		padding: 14px;
	}

	.eyebrow {
		display: inline-block;
		margin: 0 0 14px;
		padding: 6px 12px;
		border: 1px solid rgba(14, 14, 15, 0.1);
		border-radius: 999px;
		font-size: 12px;
		font-weight: 500;
	}

	.club_identity h1 {
		margin: 0;
		font-size: clamp(38px, 5.5vw, 72px);
		line-height: 1.08;
		letter-spacing: -0.055em;
	}

	.club_identity h1 + p {
		margin: 16px 0 0;
		font-size: 15px;
		color: #55555b;
	}

	.club_detail_body,
	.club_not_found {
		padding: 40px 20px 24px;
		background: var(--lex-cream, #ddd);
		color: #0e0e0f;
	}

	.club_detail_grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
		align-items: start;
		gap: 24px;
		max-width: 1240px;
		margin: 0 auto;
	}

	.club_description,
	.club_sidebar,
	.club_not_found {
		min-width: 0;
		border: 1px solid rgba(14, 14, 15, 0.1);
		border-radius: 30px;
		background: #fbf7f5;
		padding: 32px;
		overflow-wrap: anywhere;
	}

	.club_description h2,
	.club_sidebar h2 {
		margin: 0 0 24px;
		font-size: 28px;
		letter-spacing: -0.045em;
	}

	.club_description p {
		font-size: 15.5px;
		line-height: 1.85;
		color: #55555b;
	}

	.club_description p:last-child {
		margin-bottom: 0;
	}

	dl {
		margin: 0;
	}

	dl div {
		padding: 14px 0;
		border-bottom: 1px solid rgba(14, 14, 15, 0.1);
	}

	dt {
		font-size: 12px;
		font-weight: 500;
		color: #66666c;
	}

	dd {
		margin: 5px 0 0;
		font-size: 14px;
		line-height: 1.65;
	}

	.club_actions {
		display: grid;
		gap: 10px;
		margin-top: 24px;
	}

	.primary_button,
	.secondary_button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 48px;
		padding: 12px 20px;
		border: 1px solid rgba(14, 14, 15, 0.2);
		border-radius: 999px;
		color: #0e0e0f;
		font-size: 13px;
		font-weight: 500;
		text-align: center;
		text-decoration: none;
	}

	.primary_button {
		background: #00ec10;
		border-color: transparent;
	}

	.primary_button:hover,
	.secondary_button:hover,
	.back_link:hover {
		background: #0e0e0f;
		color: #fbf7f5;
	}

	a:focus-visible {
		outline: 3px solid #0e0e0f;
		outline-offset: 4px;
	}

	.club_not_found {
		width: min(760px, calc(100% - 40px));
		margin: 60px auto;
	}

	@media (max-width: 860px) {
		.club_detail_grid {
			grid-template-columns: 1fr;
		}

		.club_identity {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (max-width: 640px) {
		.club_detail_hero {
			padding: 24px 14px 0;
		}
		.club_cover_frame {
			aspect-ratio: 16 / 10;
		}
		.club_detail_body {
			padding: 28px 14px 56px;
		}
		.club_description,
		.club_sidebar {
			padding: 24px;
		}
		.club_logo {
			width: 88px;
			height: 88px;
		}
	}
	.club_weather_section,
	.club_app_section {
		padding: 0 20px 24px;
		background: var(--lex-cream, #ddd);
	}

	.club_app_section {
		padding-bottom: 88px;
	}

	.club_weather,
	.club_app {
		max-width: 1240px;
		margin: 0 auto;
		border-radius: 30px;
		padding: 36px;
	}

	.club_weather {
		border: 1px solid rgba(14, 14, 15, 0.1);
		background: #fbf7f5;
		color: #0e0e0f;
	}

	.club_app {
		background: #0e0e0f;
		color: #f1e2de;
	}

	.eyebrow_inline {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.eyebrow_dark {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border-color: rgba(241, 226, 222, 0.2);
		color: rgba(241, 226, 222, 0.8);
	}

	.live_dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #00ec10;
		box-shadow: 0 0 0 4px rgba(0, 236, 16, 0.18);
	}

	.weather_head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}

	.club_weather h2,
	.club_app h2 {
		margin: 0;
		font-size: clamp(28px, 3.4vw, 40px);
		line-height: 1.1;
		letter-spacing: -0.045em;
	}

	.weather_updated,
	.weather_loading,
	.weather_error {
		margin: 0;
		color: #66666c;
		font-size: 13px;
	}

	.weather_loading,
	.weather_error {
		margin-top: 28px;
	}

	.weather_body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
		gap: 24px 40px;
		margin-top: 32px;
	}

	.weather_body[hidden] {
		display: none;
	}

	.weather_now {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.weather_icon {
		display: grid;
		place-items: center;
		width: 112px;
		height: 112px;
		flex-shrink: 0;
		border-radius: 28px;
		background: #0e0e0f;
		font-size: 52px;
		color: #00ec10;
	}

	.weather_temp {
		margin: 0;
		font-size: 76px;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.06em;
	}

	.weather_desc {
		margin: 8px 0 0;
		font-size: 18px;
		font-weight: 600;
	}

	.weather_golf {
		margin: 4px 0 0;
		color: #55555b;
		font-size: 14px;
