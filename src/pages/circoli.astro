---
import BaseLayout from '../layouts/BaseLayout.astro';
import { circoloSlug, fetchCircoli } from '../lib/supabase';

const circoli = await fetchCircoli();

function locationLabel(circolo: (typeof circoli)[number]) {
	return [circolo.paese, circolo.provincia].filter(Boolean).join(' · ');
}
---

<BaseLayout
	title="Circoli"
	seoTitle="Circoli golf"
	seoDescription="Consulta l'elenco dei circoli golf presenti su Golfista."
>
	<section class="clubs_hero">
		<div class="clubs_hero_inner">
			<p class="eyebrow">Golfista</p>
			<h1>Circoli golf</h1>
			<p>Scopri i circoli presenti nel database Golfista e consulta le informazioni disponibili.</p>
		</div>
	</section>

	<section class="clubs_section">
		<div class="clubs_section_inner">
			<div class="clubs_summary">
				<h2>{circoli.length} circoli disponibili</h2>
			</div>

			{circoli.length === 0 ? (
				<p>Nessun circolo disponibile al momento.</p>
			) : (
				<div class="clubs_grid">
					{circoli.map((circolo) => {
						const href = `/circoli/${circoloSlug(circolo)}`;
						const location = locationLabel(circolo);
						const coverImage = circolo.local_cover_url || circolo.cover_image_url || circolo.cover_url || circolo.logo_url;
						return (
							<article class="club_card">
								<a href={href} class="club_card_link">
									{coverImage ? (
										<img
											src={coverImage}
											alt={circolo.nomecircolo || 'Circolo golf'}
											loading="lazy"
											decoding="async"
											data-fallback-one={`/circoli/${circolo.idcircolo}.1.jpg`}
											data-fallback-two={`/circoli/${circolo.idcircolo}.2.jpg`}
											onerror="if(!this.dataset.triedOne){this.dataset.triedOne='1';this.src=this.dataset.fallbackOne;}else if(!this.dataset.triedTwo){this.dataset.triedTwo='1';this.src=this.dataset.fallbackTwo;}else{this.style.display='none';this.nextElementSibling.style.display='flex';}"
										/>
									) : (
										null
									)}
									<div class="club_card_placeholder" style={coverImage ? 'display:none' : undefined}>Golfista</div>
									<div class="club_card_content">
										<h3>{circolo.nomecircolo || `Circolo ${circolo.idcircolo}`}</h3>
										{location && <p>{location}</p>}
										{circolo.indirizzo && <p class="club_address">{circolo.indirizzo}</p>}
										<span>Vedi scheda</span>
									</div>
								</a>
							</article>
						);
					})}
				</div>
			)}
		</div>
	</section>
</BaseLayout>

<style>
	.clubs_hero {
		padding: 70px 20px 34px;
		background: linear-gradient(135deg, rgba(0, 236, 16, 0.18), rgba(255, 255, 255, 0));
	}

	.clubs_hero_inner,
	.clubs_section_inner {
		max-width: var(--max-width);
		margin: 0 auto;
	}

	.eyebrow {
		margin: 0 0 8px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--primary);
	}

	.clubs_hero h1 {
		margin: 0;
		font-size: clamp(42px, 7vw, 92px);
		line-height: 0.95;
	}

	.clubs_hero p:last-child {
		max-width: 720px;
		font-size: 20px;
		line-height: 1.5;
	}

	.clubs_section {
		padding: 34px 20px 80px;
	}

	.clubs_summary h2 {
		margin: 0 0 24px;
	}

	.clubs_grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.club_card {
		min-width: 0;
	}

	.club_card_link {
		display: block;
		height: 100%;
		overflow: hidden;
		border-radius: 24px;
		background: #fff;
		color: inherit;
		text-decoration: none;
		box-shadow: 0 12px 34px rgba(0, 0, 0, 0.08);
		transition: transform 180ms ease, box-shadow 180ms ease;
	}

	.club_card_link:hover {
		transform: translateY(-4px);
		box-shadow: 0 18px 46px rgba(0, 0, 0, 0.12);
	}

	.club_card img,
	.club_card_placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 190px;
		object-fit: cover;
		background: #101810;
		color: var(--primary);
		font-weight: 800;
		letter-spacing: 0.06em;
	}

	.club_card_content {
		padding: 22px;
	}

	.club_card_content h3 {
		margin: 0 0 10px;
		font-size: 24px;
		line-height: 1.1;
	}

	.club_card_content p {
		margin: 0 0 8px;
		line-height: 1.45;
	}

	.club_address {
		opacity: 0.72;
	}

	.club_card_content span {
		display: inline-block;
		margin-top: 14px;
		font-weight: 700;
		color: var(--primary);
	}

	@media (max-width: 980px) {
		.clubs_grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.clubs_grid {
			grid-template-columns: 1fr;
		}

		.clubs_hero {
			padding-top: 46px;
		}
	}
</style>
