---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { assertSupabasePublicConfig, circoloSlug, fetchCircoli } from '../lib/supabase';

export const prerender = true;

assertSupabasePublicConfig();
const circoli = await fetchCircoli();

function locationLabel(circolo: (typeof circoli)[number]) {
	return [circolo.paese, circolo.provincia].filter(Boolean).join(' · ');
}
---

<BaseLayout
	title="Circoli"
	seoTitle="Circoli golf: elenco e schede"
	seoDescription="Scopri i circoli golf presenti su Golfista e consulta le schede con località, descrizioni e recapiti disponibili per ciascun club."
>
	<PageHero
		title="Circoli golf"
		highlight="da scoprire"
		description="Scopri i circoli presenti nel database Golfista e consulta le informazioni disponibili."
	/>

	<section class="clubs_section">
		<div class="clubs_section_inner">
			<div class="clubs_summary">
				<h2>{circoli.length} circoli disponibili</h2>
			</div>

			{circoli.length === 0 ? (
				<p>Nessun circolo disponibile al momento.</p>
			) : (
				<div class="clubs_grid">
					{circoli.map((circolo) => {
						const href = `/circoli/${circoloSlug(circolo)}`;
						const location = locationLabel(circolo);
						const coverImage = circolo.local_cover_url || circolo.cover_image_url || circolo.cover_url || circolo.logo_url;
						return (
							<article class="club_card">
								<a href={href} class="club_card_link">
									{coverImage ? (
										<img
											src={coverImage}
											alt={circolo.nomecircolo || 'Circolo golf'}
											loading="lazy"
											decoding="async"
											data-fallback-one={`/circoli/${circolo.idcircolo}.1.jpg`}
											data-fallback-two={`/circoli/${circolo.idcircolo}.2.jpg`}
											onerror="if(!this.dataset.triedOne){this.dataset.triedOne='1';this.src=this.dataset.fallbackOne;}else if(!this.dataset.triedTwo){this.dataset.triedTwo='1';this.src=this.dataset.fallbackTwo;}else{this.style.display='none';this.nextElementSibling.style.display='flex';}"
										/>
									) : (
										null
									)}
									<div class="club_card_placeholder" style={coverImage ? 'display:none' : undefined}>Golfista</div>
									<div class="club_card_content">
										<h3>{circolo.nomecircolo || `Circolo ${circolo.idcircolo}`}</h3>
										{location && <p>{location}</p>}
										{circolo.indirizzo && <p class="club_address">{circolo.indirizzo}</p>}
									<span>Vedi scheda <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
									</div>
								</a>
							</article>
						);
					})}
				</div>
			)}
		</div>
	</section>
</BaseLayout>

<style>
	.clubs_section_inner {
		max-width: 1240px;
		margin: 0 auto;
	}

	.clubs_section {
		padding: 12px 20px 88px;
		background: var(--lex-cream, #ddd);
		color: #0e0e0f;
	}

	.clubs_summary h2 {
		margin: 0 0 28px;
		padding-top: 28px;
		border-top: 1px solid rgba(14, 14, 15, 0.1);
		font-size: clamp(22px, 3vw, 30px);
		letter-spacing: -0.04em;
	}

	.clubs_grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 22px;
	}

	.club_card {
		min-width: 0;
	}

	.club_card_link {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid rgba(14, 14, 15, 0.1);
		border-radius: 30px;
		background: #fbf7f5;
		color: inherit;
		text-decoration: none;
		transition: transform 180ms ease, border-color 180ms ease;
	}

	.club_card_link:hover {
		transform: translateY(-3px);
		border-color: rgba(14, 14, 15, 0.35);
	}

	.club_card_link:focus-visible {
		outline: 3px solid #0e0e0f;
		outline-offset: 5px;
	}

	.club_card img,
	.club_card_placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		aspect-ratio: 16 / 10;
		height: auto;
		flex-shrink: 0;
		object-fit: cover;
		background: #0e0e0f;
		color: #00ec10;
		font-weight: 600;
		font-size: 26px;
		letter-spacing: -0.05em;
	}

	.club_card_content {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		padding: 26px;
		overflow-wrap: anywhere;
	}

	.club_card_content h3 {
		margin: 0 0 10px;
		font-size: 25px;
		line-height: 1.18;
		letter-spacing: -0.045em;
	}

	.club_card_content p {
		margin: 0 0 8px;
		font-size: 14px;
		line-height: 1.45;
	}

	.club_address {
		opacity: 0.72;
	}

	.club_card_content span {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin-top: auto;
		padding-top: 24px;
		font-size: 13px;
		font-weight: 500;
		color: #0e0e0f;
	}

	.club_card_content span i {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		background: #00ec10;
	}

	@media (max-width: 980px) {
		.clubs_grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.clubs_grid {
			grid-template-columns: 1fr;
		}

		.clubs_section {
			padding: 8px 14px 56px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.club_card_link {
			transition: none;
		}
		.club_card_link:hover {
			transform: none;
		}
	}
</style>
