---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRCode from 'qrcode';

export const prerender = true;

const APP_STORE_URL = 'https://apps.apple.com/app/golfista/id6760565939';
const PLAY_STORE_URL = 'https://play.google.com/store/apps/details?id=it.golfista.app';

const qrOptions = { type: 'svg' as const, margin: 0, errorCorrectionLevel: 'M' as const, color: { dark: '#0E0E0F', light: '#FFFFFF' } };
const stores = [
	{
		id: 'ios',
		kicker: 'Scarica su',
		name: 'App Store',
		device: 'iPhone',
		text: 'Apri la fotocamera dell’iPhone, inquadra il codice e tocca il link: si apre direttamente la pagina di Golfista sull’App Store.',
		url: APP_STORE_URL,
		qr: await QRCode.toString(APP_STORE_URL, qrOptions),
	},
	{
		id: 'android',
		kicker: 'Disponibile su',
		name: 'Google Play',
		device: 'Android',
		text: 'Inquadra il codice con la fotocamera o con Google Lens: ti porta subito alla scheda di Golfista sul Play Store.',
		url: PLAY_STORE_URL,
		qr: await QRCode.toString(PLAY_STORE_URL, qrOptions),
	},
];

const screens = ['/images/app/screen-2.jpg', '/images/app/screen-1.jpg', '/images/app/screen-5.jpg'];
---

<BaseLayout
	title="Scarica l'app"
	seoTitle="Scarica l'app Golfista"
	seoDescription="Scarica gratis l'app Golfista per iPhone e Android dall'App Store o da Google Play."
	topColor="#0E0E0F"
>
	<script is:inline define:vars={{ ios: APP_STORE_URL, android: PLAY_STORE_URL }}>
		(function () {
			var ua = navigator.userAgent || '';
			var isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
			var isAndroid = /Android/i.test(ua);
			if (isIOS) window.location.replace(ios);
			else if (isAndroid) window.location.replace(android);
		})();
	</script>

	<div class="dl">
		<div class="dl-glow" aria-hidden="true"></div>
		<div class="dl-grid-lines" aria-hidden="true"></div>

		<div class="dl-container">
			<div class="dl-preview">
				<img class="dl-preview-bg" src="/images/golf/golf-course-sunset.jpg" alt="" width="2000" height="1125" />
				<div class="dl-preview-shade" aria-hidden="true"></div>
				<div class="dl-phones" aria-hidden="true">
					{screens.map((src, index) => (
						<div class={`dl-phone dl-phone-${index + 1}`}>
							<img src={src} alt="" width="461" height="1000" />
						</div>
					))}
				</div>
			</div>

			<header class="dl-intro">
				<p class="dl-badge"><span class="dl-dot"></span> App gratuita per golfisti</p>
				<h1>Scarica <span class="dl-mark">Golfista</span></h1>
				<p class="dl-sub">Gare di oggi, mappa dei circoli, meteo e condizioni del campo, recensioni. Tutto gratis, su iPhone e Android.</p>
			</header>

			<div class="dl-stores">
				{stores.map((store) => (
					<article class="dl-card">
						<a class="dl-store" href={store.url} rel="noopener" aria-label={`${store.kicker} ${store.name}`}>
							{store.id === 'ios' ? (
								<svg viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
							) : (
								<svg viewBox="0 0 512 512" aria-hidden="true"><path fill="#00d7fe" d="M48 59.5v393c0 9 4 15.5 10 19L272 256 58 40.5c-6 3.5-10 10-10 19z"/><path fill="#00f076" d="M346 182 99.5 40.6C83 31 67 31 58 40.5L272 256z"/><path fill="#ffc900" d="m346 330 84-48.3c26-15 26-36.4 0-51.4L346 182l-74 74z"/><path fill="#ff3a44" d="M58 471.5c9 9.5 25 9.5 41.5 0L346 330l-74-74z"/></svg>
							)}
							<span><small>{store.kicker}</small>{store.name}</span>
						</a>
						<div class="dl-qr" set:html={store.qr} />
						<p class="dl-device">Per {store.device}</p>
						<p class="dl-text">{store.text}</p>
					</article>
				))}
			</div>

			<p class="dl-note"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Nessun costo: scarichi l’app e inizi subito.</p>
		</div>
	</div>
</BaseLayout>

<style>
	.dl {
		position: relative;
		overflow: hidden;
		margin-top: -104px;
		padding: 150px 0 110px;
		background: var(--lex-dark);
		color: var(--lex-cream);
	}

	.dl-glow {
		position: absolute;
		inset: -20% -15% auto auto;
		width: 70vw;
		height: 70vw;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(20, 113, 91, 0.34) 0%, rgba(20, 113, 91, 0) 68%);
		pointer-events: none;
	}

	.dl-grid-lines {
		position: absolute;
		inset: 0;
		opacity: 0.18;
		background-image:
			linear-gradient(rgba(241, 226, 222, 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(241, 226, 222, 0.08) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: linear-gradient(to bottom, #000 0%, transparent 70%);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 70%);
		pointer-events: none;
	}

	.dl-container {
		position: relative;
		z-index: 1;
		width: min(1040px, calc(100% - 40px));
		margin-inline: auto;
	}

	/* Preview */
	.dl-preview {
		position: relative;
		height: 420px;
		overflow: hidden;
		border: 1px solid rgba(241, 226, 222, 0.12);
		border-radius: 32px;
		box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45);
	}

	.dl-preview-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.dl-preview-shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, rgba(14, 14, 15, 0) 30%, rgba(14, 14, 15, 0.85) 100%);
	}

	.dl-phones {
		position: absolute;
		inset: auto 0 -120px;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		gap: 28px;
	}

	.dl-phone {
		width: 210px;
		padding: 8px;
		border-radius: 36px;
		background: #111;
		box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
	}

	.dl-phone img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 28px;
	}

	.dl-phone-1 { transform: translateY(40px) rotate(-6deg); }
	.dl-phone-2 { width: 240px; z-index: 1; }
	.dl-phone-3 { transform: translateY(40px) rotate(6deg); }

	/* Intro */
	.dl-intro {
		margin-top: 64px;
		text-align: center;
	}

	.dl-badge {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		margin: 0 0 24px;
		padding: 8px 14px;
		border: 1px solid rgba(241, 226, 222, 0.2);
		border-radius: 999px;
		color: rgba(241, 226, 222, 0.78);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.1em;
		line-height: 1;
		text-transform: uppercase;
	}

	.dl-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--header-green, #00ec10);
		box-shadow: 0 0 0 4px rgba(0, 236, 16, 0.15);
	}

	.dl-intro h1 {
		margin: 0;
		color: var(--lex-cream);
		font-size: clamp(46px, 6vw, 82px);
		font-weight: 600;
		line-height: 1.03;
		letter-spacing: -0.06em;
	}

	.dl-mark {
		display: inline-block;
		padding: 0 0.14em;
		border-radius: 10px;
		background: var(--header-green, #00ec10);
		color: #000;
		transform: rotate(-1.5deg);
	}

	.dl-sub {
		max-width: 640px;
		margin: 24px auto 0;
		color: rgba(241, 226, 222, 0.72);
		font-size: 17px;
		line-height: 1.7;
	}

	/* Stores */
	.dl-stores {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		max-width: 820px;
		margin: 56px auto 0;
	}

	.dl-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 36px 32px 32px;
		border: 1px solid rgba(241, 226, 222, 0.12);
		border-radius: 28px;
		background: var(--lex-dark-raised, #1c1c1e);
		text-align: center;
		transition: transform 0.25s ease, border-color 0.25s ease;
	}

	.dl-card:hover {
		transform: translateY(-4px);
		border-color: rgba(0, 236, 16, 0.4);
	}

	.dl-store {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		padding: 14px 28px;
		border-radius: 16px;
		background: #000;
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: #fff;
		text-decoration: none;
		transition: background 0.2s ease;
	}

	.dl-store:hover { background: #222; }
	.dl-store svg { width: 40px; height: 40px; flex: none; }
	.dl-store span { display: flex; flex-direction: column; align-items: flex-start; font-size: 26px; font-weight: 600; line-height: 1.1; letter-spacing: -0.02em; }
	.dl-store small { font-size: 13px; font-weight: 400; opacity: 0.8; letter-spacing: 0; }

	.dl-qr {
		width: 220px;
		height: 220px;
		margin-top: 28px;
		padding: 18px;
		border-radius: 22px;
		background: #fff;
		box-sizing: content-box;
	}

	.dl-qr :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.dl-device {
		margin: 24px 0 0;
		color: var(--lex-cream);
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.dl-text {
		max-width: 320px;
		margin: 8px 0 0;
		color: rgba(241, 226, 222, 0.6);
		font-size: 14px;
		line-height: 1.65;
	}

	.dl-note {
		margin: 40px 0 0;
		color: rgba(241, 226, 222, 0.6);
		font-size: 14px;
		text-align: center;
	}

	.dl-note i { color: var(--header-green, #00ec10); margin-right: 6px; }

	/* Touch / mobile: niente QR, solo pulsanti */
	@media (hover: none), (max-width: 760px) {
		.dl-qr, .dl-text { display: none; }
		.dl-device { margin-top: 16px; }
	}

	@media (max-width: 760px) {
		.dl { padding: 130px 0 72px; }
		.dl-preview { height: 300px; border-radius: 24px; }
		.dl-phones { gap: 12px; bottom: -90px; }
		.dl-phone { width: 120px; padding: 5px; border-radius: 22px; }
		.dl-phone img { border-radius: 18px; }
		.dl-phone-2 { width: 140px; }
		.dl-stores { grid-template-columns: 1fr; }
	}
</style>
