---
interface Props {
	umamiScriptSrc?: string;
	umamiWebsiteId?: string;
	googleAdsId?: string;
}

const { umamiScriptSrc = '', umamiWebsiteId = '', googleAdsId = '' } = Astro.props;
---

<section class="cookie-consent" id="cookie-consent" aria-labelledby="cookie-consent-title" hidden>
	<div class="cookie-consent__panel">
		<div class="cookie-consent__copy">
			<p class="cookie-consent__eyebrow">La tua privacy</p>
			<h2 id="cookie-consent-title">Cookie e preferenze</h2>
			<p>
				Usiamo cookie tecnici necessari al funzionamento del sito. Con il tuo consenso possiamo usare cookie
				analitici e di marketing per migliorare il servizio e misurare le campagne.
				<a href="/cookie-policy">Leggi la cookie policy</a>.
			</p>
		</div>
		<div class="cookie-consent__actions">
			<button class="cookie-consent__button cookie-consent__button--primary" type="button" data-cookie-action="accept">
				Accetta tutti
			</button>
			<button class="cookie-consent__button cookie-consent__button--primary" type="button" data-cookie-action="reject">
				Rifiuta non necessari
			</button>
			<button class="cookie-consent__button cookie-consent__button--ghost" type="button" data-cookie-action="preferences">
				Personalizza
			</button>
		</div>
	</div>
</section>

<div class="cookie-modal" id="cookie-preferences" hidden>
	<div class="cookie-modal__overlay" data-cookie-close></div>
	<div class="cookie-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="cookie-preferences-title">
		<div class="cookie-modal__head">
			<div>
				<p class="cookie-consent__eyebrow">Preferenze cookie</p>
				<h2 id="cookie-preferences-title">Scegli come usiamo i cookie</h2>
			</div>
			<button class="cookie-modal__close" type="button" aria-label="Chiudi preferenze cookie" data-cookie-close>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>

		<p class="cookie-modal__intro">
			Puoi modificare la tua scelta in qualsiasi momento. I cookie necessari restano sempre attivi.
		</p>

		<div class="cookie-modal__options">
			<label class="cookie-option">
				<span class="cookie-option__copy">
					<strong>Cookie necessari</strong>
					<span>Indispensabili per il funzionamento e la sicurezza del sito.</span>
				</span>
				<input type="checkbox" checked disabled />
			</label>
			<label class="cookie-option">
				<span class="cookie-option__copy">
					<strong>Analisi statistica</strong>
					<span>Statistiche aggregate sulle visite tramite Umami, senza profilazione pubblicitaria.</span>
				</span>
				<input type="checkbox" data-cookie-category="analytics" />
			</label>
			<label class="cookie-option">
				<span class="cookie-option__copy">
					<strong>Marketing</strong>
					<span>Misurazione delle campagne e delle conversioni tramite Google Ads e Meta Pixel (Facebook e Instagram).</span>
				</span>
				<input type="checkbox" data-cookie-category="marketing" />
			</label>
		</div>

		<div class="cookie-modal__actions">
			<button class="cookie-consent__button cookie-consent__button--primary" type="button" data-cookie-action="save">
				Salva preferenze
			</button>
			<button class="cookie-consent__button cookie-consent__button--ghost" type="button" data-cookie-close>
				Annulla
			</button>
		</div>
	</div>
</div>

<script is:inline define:vars={{ umamiScriptSrc, umamiWebsiteId, googleAdsId }}>
	(() => {
		const STORAGE_KEY = 'golfista_cookie_consent_v1';
		const CONSENT_VERSION = 1;
		const CONSENT_AGE = 1000 * 60 * 60 * 24 * 180;
		const banner = document.getElementById('cookie-consent');
		const modal = document.getElementById('cookie-preferences');
		const analyticsInput = modal?.querySelector('[data-cookie-category="analytics"]');
		const marketingInput = modal?.querySelector('[data-cookie-category="marketing"]');

		if (!banner || !modal || !analyticsInput || !marketingInput) return;

		let analyticsLoaded = false;
		let marketingLoaded = false;
		let lastFocused = null;
		let currentConsent = null;
		let inertElements = [];

		const isLocalhost = () => {
			const host = window.location.hostname;
			return host === 'localhost' || host === '127.0.0.1' || host === '::1' || host.endsWith('.local');
		};

		const readConsent = () => {
			try {
				const raw = window.localStorage.getItem(STORAGE_KEY);
				if (!raw) return null;
				const parsed = JSON.parse(raw);
				if (!parsed || parsed.version !== CONSENT_VERSION || typeof parsed.savedAt !== 'string') return null;
				if (typeof parsed.analytics !== 'boolean' || typeof parsed.marketing !== 'boolean') return null;
				const age = Date.now() - new Date(parsed.savedAt).getTime();
				if (!Number.isFinite(age) || age < 0 || age > CONSENT_AGE) return null;
				return {
					necessary: true,
					analytics: Boolean(parsed.analytics),
					marketing: Boolean(parsed.marketing),
				};
			} catch {
				return null;
			}
		};

		const writeConsent = (consent) => {
			const payload = {
				version: CONSENT_VERSION,
				savedAt: new Date().toISOString(),
				necessary: true,
				analytics: Boolean(consent.analytics),
				marketing: Boolean(consent.marketing),
			};

			try {
				window.localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
			} catch {
				// Se lo storage non è disponibile, la preferenza resta valida per la pagina corrente.
			}

			return payload;
		};

		const clearCookie = (name) => {
			const parts = window.location.hostname.split('.');
			const domains = [''];
			while (parts.length > 1) {
				domains.push(parts.join('.'), `.${parts.join('.')}`);
				parts.shift();
			}
			for (const domain of domains) {
				document.cookie = `${name}=; Max-Age=0; path=/${domain ? `; domain=${domain}` : ''}`;
			}
		};

		const loadAnalytics = () => {
			if (analyticsLoaded || !umamiScriptSrc || !umamiWebsiteId || isLocalhost()) return;
			if (document.querySelector('script[data-golfista-umami]')) {
				analyticsLoaded = true;
				return;
			}

			analyticsLoaded = true;
			const script = document.createElement('script');
			script.defer = true;
			script.src = umamiScriptSrc;
			script.dataset.websiteId = umamiWebsiteId;
			script.dataset.golfistaUmami = 'true';
			document.head.appendChild(script);
		};

		const loadMarketing = () => {
			if (marketingLoaded || !googleAdsId || isLocalhost()) return;
			if (document.querySelector('script[data-golfista-google-ads]')) {
				marketingLoaded = true;
				return;
			}

			marketingLoaded = true;

			try {
				const attributionParams = new URLSearchParams(window.location.search || '');
				for (const key of ['gclid', 'gbraid', 'wbraid']) {
					const value = attributionParams.get(key);
					if (value) sessionStorage.setItem(`attribution_${key}`, value);
				}
			} catch {
				// Tracking consent must still work when browser storage is blocked.
			}

			const script = document.createElement('script');
			script.async = true;
			script.src = `https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`;
			script.dataset.golfistaGoogleAds = 'true';
			document.head.appendChild(script);

			window.dataLayer = window.dataLayer || [];
			window.gtag = function () {
				window.dataLayer.push(arguments);
			};
			window.gtag('js', new Date());
			window.gtag('consent', 'update', {
				ad_storage: 'granted',
				ad_user_data: 'granted',
				ad_personalization: 'granted',
			});
			window.gtag('config', googleAdsId);
		};

		const META_PIXEL_ID = '1073785302359806';
		let metaPixelLoaded = false;

		const loadMetaPixel = () => {
			if (metaPixelLoaded || isLocalhost()) return;
			metaPixelLoaded = true;
			if (window.fbq) {
				window.fbq('consent', 'grant');
				return;
			}
			// Meta Pixel Code
			!function(f,b,e,v,n,t,s)
			{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
			n.callMethod.apply(n,arguments):n.queue.push(arguments)};
			if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
			n.queue=[];t=b.createElement(e);t.async=!0;
			t.src=v;s=b.getElementsByTagName(e)[0];
			s.parentNode.insertBefore(t,s)}(window, document,'script',
			'https://connect.facebook.net/en_US/fbevents.js');
			window.fbq('init', META_PIXEL_ID);
			window.fbq('track', 'PageView');
			// End Meta Pixel Code
		};

		const applyConsent = (consent) => {
			if (consent.analytics) {
				loadAnalytics();
			} else {
				analyticsLoaded = false;
			}

			if (consent.marketing) {
				loadMarketing();
				loadMetaPixel();
			} else {
				marketingLoaded = false;
				if (metaPixelLoaded && window.fbq) window.fbq('consent', 'revoke');
				metaPixelLoaded = false;
				clearCookie('_fbp');
				clearCookie('_fbc');
				clearCookie('_gcl_au');
				clearCookie('_gcl_aw');
				try {
					for (const key of ['gclid', 'gbraid', 'wbraid']) sessionStorage.removeItem(`attribution_${key}`);
				} catch {}
			}
		};

		const syncInputs = (consent) => {
			analyticsInput.checked = Boolean(consent?.analytics);
			marketingInput.checked = Boolean(consent?.marketing);
		};

		const showBanner = () => {
			banner.hidden = false;
		};

		const hideBanner = () => {
			banner.hidden = true;
		};

		const openPreferences = () => {
			lastFocused = document.activeElement;
			currentConsent = readConsent() || currentConsent;
			syncInputs(currentConsent);
			inertElements = [...document.body.children].filter((element) =>
				element !== modal && !element.inert && !['SCRIPT', 'STYLE', 'LINK'].includes(element.tagName)
			);
			inertElements.forEach((element) => { element.inert = true; });
			modal.hidden = false;
			document.body.classList.add('cookie-modal-open');
			window.requestAnimationFrame(() => analyticsInput.focus());
		};

		const closePreferences = () => {
			modal.hidden = true;
			document.body.classList.remove('cookie-modal-open');
			inertElements.forEach((element) => { element.inert = false; });
			inertElements = [];
			if (lastFocused instanceof HTMLElement && lastFocused.offsetParent !== null) lastFocused.focus();
		};

		const saveConsent = (consent) => {
			const previous = currentConsent;
			const next = writeConsent(consent);
			hideBanner();
			closePreferences();
			currentConsent = next;

			const revoked =
				previous &&
				((previous.analytics && !next.analytics) || (previous.marketing && !next.marketing));
			if (revoked) {
				applyConsent({ analytics: false, marketing: false });
				window.location.reload();
				return;
			}
			applyConsent(next);
		};

		banner.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const action = target.closest('[data-cookie-action]')?.getAttribute('data-cookie-action');
			if (action === 'accept') saveConsent({ analytics: true, marketing: true });
			if (action === 'reject') saveConsent({ analytics: false, marketing: false });
			if (action === 'preferences') openPreferences();
		});

		modal.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			if (target.closest('[data-cookie-close]')) {
				closePreferences();
				return;
			}
			const action = target.closest('[data-cookie-action]')?.getAttribute('data-cookie-action');
			if (action === 'save') {
				saveConsent({
					analytics: analyticsInput.checked,
					marketing: marketingInput.checked,
				});
			}
		});

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			if (!target.closest('[data-cookie-preferences]')) return;
			event.preventDefault();
			openPreferences();
		});

		document.addEventListener('keydown', (event) => {
			if (modal.hidden) return;
			if (event.key === 'Escape') {
				closePreferences();
				return;
			}
			if (event.key !== 'Tab') return;

			const focusable = [...modal.querySelectorAll('button:not([disabled]), input:not([disabled]), a[href]')].filter(
				(element) => element instanceof HTMLElement && element.offsetParent !== null
			);
			if (!focusable.length) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		const storedConsent = readConsent();
		if (storedConsent) {
			currentConsent = storedConsent;
			applyConsent(storedConsent);
		} else {
			showBanner();
		}
	})();
</script>

<style>
	.cookie-consent[hidden],
	.cookie-modal[hidden] {
		display: none;
	}

	.cookie-consent {
		position: fixed;
		z-index: 2000;
		right: 20px;
		bottom: 20px;
		left: 20px;
		display: flex;
		justify-content: center;
		pointer-events: none;
	}

	.cookie-consent__panel {
		display: grid;
		width: min(100%, 980px);
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 28px;
		align-items: end;
		padding: 24px;
		max-height: 85dvh;
		overflow-y: auto;
		border: 1px solid rgba(14, 14, 15, 0.12);
		border-radius: 24px;
		background: #fff;
		color: var(--lex-dark);
		box-shadow: 0 24px 70px rgba(14, 14, 15, 0.24);
		pointer-events: auto;
	}

	.cookie-consent__eyebrow {
		margin: 0 0 6px;
		color: var(--lex-green);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.cookie-consent__panel h2,
	.cookie-modal__dialog h2 {
		margin: 0;
		font-size: 24px;
		line-height: 1.1;
	}

	.cookie-consent__copy > p:last-child {
		max-width: 590px;
		margin: 10px 0 0;
		color: #59595f;
		font-size: 13px;
		line-height: 1.55;
	}

	.cookie-consent__copy a {
		text-decoration: underline;
		text-decoration-color: var(--lex-green);
		text-underline-offset: 3px;
	}

	.cookie-consent__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 8px;
	}

	.cookie-consent__button {
		display: inline-flex;
		min-height: 42px;
		align-items: center;
		justify-content: center;
		padding: 0 16px;
		border: 1px solid rgba(14, 14, 15, 0.2);
		border-radius: 999px;
		background: #fff;
		color: var(--lex-dark);
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		cursor: pointer;
		transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
	}

	.cookie-consent__button:hover {
		border-color: var(--lex-green);
		color: var(--lex-green);
	}

	.cookie-consent__button--primary {
		border-color: var(--lex-green);
		background: var(--lex-green);
		color: #fff;
	}

	.cookie-consent__button--primary:hover {
		background: var(--lex-green-hover);
		color: #fff;
	}

	.cookie-consent__button--ghost {
		border-color: transparent;
		background: transparent;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.cookie-modal {
		position: fixed;
		z-index: 2100;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 20px;
	}

	.cookie-modal__overlay {
		position: absolute;
		inset: 0;
		background: rgba(14, 14, 15, 0.58);
		backdrop-filter: blur(3px);
	}

	.cookie-modal__dialog {
		position: relative;
		width: min(100%, 620px);
		max-height: min(86vh, 760px);
		padding: 28px;
		overflow-y: auto;
		border-radius: 26px;
		background: #fff;
		color: var(--lex-dark);
		box-shadow: 0 30px 90px rgba(14, 14, 15, 0.32);
	}

	.cookie-modal__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 18px;
	}

	.cookie-modal__close {
		display: grid;
		width: 36px;
		height: 36px;
		flex: 0 0 auto;
		place-items: center;
		padding: 0;
		border: 1px solid rgba(14, 14, 15, 0.14);
		border-radius: 50%;
		background: #fff;
		color: var(--lex-dark);
		cursor: pointer;
	}

	.cookie-modal__close svg {
		width: 18px;
		height: 18px;
	}

	.cookie-modal__intro {
		margin: 18px 0 0;
		color: #59595f;
		font-size: 13px;
		line-height: 1.55;
	}

	.cookie-modal__options {
		display: grid;
		gap: 10px;
		margin-top: 22px;
	}

	.cookie-option {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 20px;
		padding: 16px;
		border: 1px solid rgba(14, 14, 15, 0.1);
		border-radius: 16px;
		background: var(--lex-cream-soft);
		cursor: pointer;
	}

	.cookie-option__copy {
		display: grid;
		gap: 4px;
	}

	.cookie-option__copy strong {
		font-size: 14px;
	}

	.cookie-option__copy span {
		color: #64646a;
		font-size: 12px;
		line-height: 1.45;
	}

	.cookie-option input {
		width: 18px;
		height: 18px;
		flex: 0 0 auto;
		margin: 2px 0 0;
		accent-color: var(--lex-green);
	}

	.cookie-modal__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 24px;
	}

	:global(body.cookie-modal-open) {
		overflow: hidden;
	}

	@media (max-width: 760px) {
		.cookie-consent {
			right: 10px;
			bottom: 10px;
			left: 10px;
		}

		.cookie-consent__panel {
			grid-template-columns: 1fr;
			gap: 18px;
			padding: 20px;
		}

		.cookie-consent__actions {
			justify-content: stretch;
		}

		.cookie-consent__actions .cookie-consent__button {
			flex: 1 1 auto;
		}

		.cookie-modal__dialog {
			padding: 22px;
		}
	}
</style>
