---
import { primaryNavigation, socialLinks } from '../data/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="gfoot">
	<div class="gfoot_inner">
		<div class="gfoot_top">
			<div class="gfoot_brandcol">
				<a class="gfoot_brand" href="/" aria-label="Golfista, vai alla homepage">
					<img class="gfoot_logo" src="/golfista/logo-dark.svg" alt="Golfista" width="888" height="262" />
				</a>
				<p class="gfoot_tagline">La piattaforma digitale per giocatori di golf e circoli.</p>
				<div class="gfoot_social" aria-label="Profili social Golfista">
					{socialLinks.map((link) => (
						<a href={link.href} aria-label={link.label} target="_blank" rel="noopener noreferrer">
							<i class={`fa-brands ${link.icon}`} aria-hidden="true"></i>
						</a>
					))}
				</div>
			</div>

			<nav class="gfoot_nav" aria-label="Navigazione del sito">
				<p class="gfoot_title">Navigazione</p>
				<div class="gfoot_links">
					{primaryNavigation.map((link) => <a href={link.href}>{link.label}</a>)}
					<a href="/circoli">Circoli</a>
				</div>
			</nav>
		</div>

		<div class="gfoot_bottom">
			<p>Golfista © {currentYear}, Tutti i diritti riservati.</p>
			<div class="gfoot_legal">
				<a href="/privacy-policy">Privacy</a>
				<a href="/condizioni-del-servizio">Termini</a>
				<a href="/cookie-policy">Cookie</a>
				<button type="button" data-cookie-preferences>Preferenze cookie</button>
			</div>
		</div>
	</div>
</footer>

<style>
	.gfoot {
		padding: 78px 20px 28px;
		background: var(--lex-cream-soft);
		color: var(--lex-dark);
	}

	.gfoot_inner {
		width: min(1240px, 100%);
		margin: 0 auto;
	}

	.gfoot_top {
		display: grid;
		grid-template-columns: minmax(280px, 1.15fr) minmax(0, 1.85fr);
		gap: 70px;
		padding-bottom: 58px;
		border-bottom: 1px solid rgba(14, 14, 15, 0.1);
	}

	.gfoot_brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-size: 25px;
		font-weight: 600;
		letter-spacing: -0.05em;
	}

	.gfoot_mark {
		display: grid;
		width: 50px;
		height: 50px;
		place-items: center;
		overflow: hidden;
		border-radius: 50%;
		background: var(--lex-dark);
	}

	.gfoot_mark img {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		object-fit: contain;
	}

	.gfoot_logo {
		width: 140px;
		height: auto;
	}

	.gfoot_tagline {
		max-width: 360px;
		margin: 22px 0 0;
		color: #58585e;
		font-size: 14px;
		line-height: 1.7;
	}

	.gfoot_social {
		display: flex;
		gap: 8px;
		margin-top: 26px;
	}

	.gfoot_social a {
		display: grid;
		width: 44px;
		height: 44px;
		place-items: center;
		border: 1px solid rgba(14, 14, 15, 0.14);
		border-radius: 50%;
		color: var(--lex-dark);
		font-size: 15px;
		transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.gfoot_social a:hover {
		border-color: var(--lex-green);
		background: var(--lex-green);
		color: #fff;
	}

	.gfoot_nav {
		display: flex;
		justify-self: end;
		min-width: 220px;
		flex-direction: column;
		align-items: flex-start;
	}

	.gfoot_links {
		display: grid;
		grid-template-columns: repeat(2, minmax(130px, 1fr));
		gap: 12px 34px;
	}

	.gfoot_title {
		margin: 0 0 17px;
		color: var(--lex-dark);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.gfoot_links a {
		color: #5f5f66;
		font-size: 13.5px;
		line-height: 1.4;
		transition: color 0.2s ease;
	}

	.gfoot_links a:hover {
		color: var(--lex-green);
	}

	.gfoot_bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding-top: 24px;
		color: #717177;
		font-size: 11.5px;
	}

	.gfoot_bottom p {
		margin: 0;
	}

	.gfoot_bottom a,
	.gfoot_bottom button {
		padding: 0;
		border: 0;
		background: transparent;
		color: #4b4b51;
		font: inherit;
		cursor: pointer;
	}

	.gfoot_bottom a:hover,
	.gfoot_bottom button:hover {
		color: var(--lex-green);
	}

	.gfoot_legal {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 18px;
	}

	@media (max-width: 900px) {
		.gfoot_top {
			grid-template-columns: 1fr;
			gap: 42px;
		}

		.gfoot_nav {
			justify-self: start;
		}
	}

	@media (max-width: 620px) {
		.gfoot {
			padding: 54px 18px 24px;
		}

		.gfoot_links {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.gfoot_bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
