---
interface SlideItem {
	titolo?: string;
	sottotitolo?: string;
	label?: string;
	href?: string;
	immagine?: string;
}

interface Props extends SlideItem {
	slides?: SlideItem[];
}

const { slides = [], titolo = '', sottotitolo = '', label = '', href = '' } = Astro.props;
const resolvedSlides = slides.length > 0 ? slides : [{ titolo, sottotitolo, label, href }];
---

<div class="slider_block">
	{resolvedSlides.map((slide) => (
		<article class="slide_panel">
			{slide.titolo && <h2 set:html={slide.titolo} />}
			{slide.sottotitolo && <p set:html={slide.sottotitolo} />}
			{slide.label && slide.href && <a class="slider_button" href={slide.href}>{slide.label} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}
		</article>
	))}
</div>

<style>
	.slider_block {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
		gap: 20px;
		width: min(1240px, calc(100% - 40px));
		margin: 40px auto;
	}
	.slide_panel {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		padding: 40px;
		border: 1px solid rgba(14,14,15,.1);
		border-radius: 30px;
		background: var(--lex-dark);
		color: var(--lex-cream, #ddd);
	}
	.slide_panel h2 { max-width: 800px; margin: 0; color: inherit; font-size: clamp(32px, 4vw, 48px); line-height: 1.06; letter-spacing: -.05em; overflow-wrap: anywhere; }
	.slide_panel h2 :global(span) { padding-inline: .12em; border-radius: 6px; background: #00ec10; color: #000; }
	.slide_panel p { max-width: 680px; margin: 20px 0 28px; color: #bdbdc1; font-size: 15px; line-height: 1.7; }
	.slider_button { display: inline-flex; max-width: 100%; min-height: 52px; align-items: center; justify-content: center; gap: 12px; margin-top: auto; padding: 14px 24px; border-radius: 999px; background: #00ec10; color: #000; font-size: 14px; font-weight: 600; text-align: center; }
	.slider_button:hover { background: #fff; }
	.slider_button:focus-visible { outline: 3px solid #00ec10; outline-offset: 5px; }
	@media (max-width: 720px) {
		.slider_block { width: calc(100% - 28px); margin: 28px auto; }
		.slide_panel { padding: 30px 24px; }
	}
</style>
