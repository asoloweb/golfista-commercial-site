---
interface Props {
	item?: string;
	titolo?: string;
	sottotitolo?: string;
	descrizione?: string;
}

const { 
	titolo = '', 
	sottotitolo = '', 
	descrizione = '' 
} = Astro.props;
---

<div class="title_block">
	<div class="title_content">
		{titolo && <h2 set:html={titolo} />}
		{sottotitolo && <p class="title_subtitle" set:html={sottotitolo} />}
		{descrizione && <p set:html={descrizione} />}
	</div>
</div>

<style>
	.title_block {
		width: min(calc(100% - 40px), 1240px);
		padding: 64px 0 32px;
		text-align: center;
		margin: 0 auto;
	}
	.title_content {
		max-width: 860px;
		margin: 0 auto;
	}
	h2 {
		color: var(--lex-dark);
		font-size: clamp(34px, 4vw, 52px);
		line-height: 1.05;
		letter-spacing: -.05em;
		margin: 0 0 18px;
		overflow-wrap: anywhere;
	}
	h2 :global(span) {
		padding-inline: .12em;
		border-radius: 6px;
		background: #00ec10;
		color: #000;
	}
	p {
		color: #5d5d63;
		font-size: 15px;
		line-height: 1.7;
	}
	.title_subtitle { color: var(--lex-dark); font-size: 18px; }
	@media (max-width: 640px) { .title_block { width: calc(100% - 28px); padding-top: 48px; } }
</style>
