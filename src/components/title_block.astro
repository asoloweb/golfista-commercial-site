---
interface Props {
	item: string;
	titolo?: string;
	sottotitolo?: string;
	descrizione?: string;
}

const { 
	item, 
	titolo = '', 
	sottotitolo = '', 
	descrizione = '' 
} = Astro.props;
---

<div class="title_block">
	<div class="title_content">
		{titolo && <h1 set:html={titolo} />}
		{sottotitolo && <h2 set:html={sottotitolo} />}
		{descrizione && <p set:html={descrizione} />}
	</div>
</div>

<style>
	.title_block {
		width: min(calc(100% - 40px), var(--max-width));
		padding: 54px 30px;
		text-align: center;
		background-color: var(--surface);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		margin: 0 auto 40px;
	}
	.title_content {
		max-width: 860px;
		margin: 0 auto;
		padding: 0 15px;
	}
	h1 {
		color: var(--nero);
		font-size: clamp(48px, 6vw, 72px);
		line-height: .95;
		margin: 0 0 18px;
	}
	h2 {
		color: var(--nero);
		font-family: var(--font-body);
		font-size: 1.25rem;
		margin-bottom: 20px;
	}
	p {
		color: var(--nero);
		line-height: 1.6;
	}
</style>
