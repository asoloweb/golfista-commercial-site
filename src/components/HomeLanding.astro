---
import 'mapbox-gl/dist/mapbox-gl.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { circoloSlug, fetchCircoli } from '../lib/supabase';

function pickRandom<T>(items: T[], count: number) {
	const pool = [...items];
	for (let index = pool.length - 1; index > 0; index -= 1) {
		const randomIndex = Math.floor(Math.random() * (index + 1));
		[pool[index], pool[randomIndex]] = [pool[randomIndex], pool[index]];
	}
	return pool.slice(0, count);
}

const circoli = await fetchCircoli();
const circoliConLogo = circoli.flatMap((circolo) => {
	const localLogo = `/loghi/${circolo.idcircolo}.png`;
	const logo = existsSync(join(process.cwd(), 'public', 'loghi', `${circolo.idcircolo}.png`))
		? localLogo
		: circolo.logo_url;

	if (!logo || !circolo.nomecircolo) return [];

	return [{
		nome: circolo.nomecircolo,
		logo,
		href: `/circoli/${circoloSlug(circolo)}`,
	}];
});
const brandCircoli = pickRandom(circoliConLogo, 20);
const showDemoVideo = false;

const featureCards = [
	{
		kicker: 'Controllo in tempo reale dei giocatori',
		text: 'Segui chi è in campo, la buca attuale e l’avanzamento del giro con una mappa aggiornata in tempo reale.',
		cta: 'Scopri di più',
		href: '/gestionale',
		image: '/images/features/monitoraggio-giocatori.webp',
		mobileImage: '/images/features/mappa-giocatori.webp',
		imageWidth: 1440,
		imageHeight: 810,
		imageAlt: 'Mappa in tempo reale dei giocatori sul campo',
		tone: 'cream',
	},
	{
		kicker: 'Gestione completa delle convenzioni tra circoli',
		text: 'Organizza accordi, green fee e reciprocità tra circoli in un unico spazio sempre aggiornato.',
		cta: 'Scopri di più',
		href: '/gestionale',
		image: '/images/features/convenzioni.webp',
		imageWidth: 1440,
		imageHeight: 870,
		imageAlt: 'Gestione delle convenzioni tra circoli',
		tone: 'dark',
	},
	{
		kicker: 'Foto, recensioni e commenti',
		text: 'Raccogli e condividi contenuti del circolo, recensioni dei giocatori e feedback in modo semplice.',
		cta: 'Scopri di più',
		href: '/gestionale',
		image: '/images/features/dettaglio-circolo.webp',
		imageWidth: 1440,
		imageHeight: 808,
		imageAlt: 'Scheda del circolo Golfista con le sezioni recensioni e foto',
		tone: 'cream',
	},
	{
		kicker: 'Confronto tra circoli e statistiche',
		text: 'Confronta performance e dati del tuo circolo con gli altri e monitora i trend più importanti.',
		cta: 'Scopri di più',
		href: '/gestionale',
		image: '/images/features/dashboard.webp',
		imageWidth: 1440,
		imageHeight: 811,
		imageAlt: 'Statistiche e confronto tra circoli',
		tone: 'dark',
	},
];

const keyFeatures = [
	{ icon: 'fa-route', title: 'Gestione dei percorsi', text: 'Crea e aggiorna buche, distanze e informazioni utili di ogni percorso.', href: '/gestionale' },
	{ icon: 'fa-location-dot', title: 'Inserimento punti di interesse', text: 'Aggiungi ristori, ostacoli e servizi direttamente sulla mappa del circolo.', href: '/gestionale' },
	{ icon: 'fa-star-half-stroke', title: 'Moderazione recensioni', text: 'Approva e gestisci le recensioni per mantenere contenuti affidabili.', href: '/gestionale' },
	{ icon: 'fa-images', title: 'Caricamento foto del circolo', text: 'Carica e organizza le immagini per raccontare il circolo ai giocatori.', href: '/gestionale' },
	{ icon: 'fa-flag-checkered', title: 'Inserimento delle gare', text: 'Pubblica gare con date, formule e dettagli di partecipazione.', href: '/gestionale' },
	{ icon: 'fa-id-card', title: 'Anagrafica del giocatore', text: 'Gestisci i dati dei giocatori in un profilo completo e aggiornato.', href: '/gestionale' },
];

const plans = [
	{
		name: 'Gratuito per sempre',
		price: '€0',
		description: 'Le funzioni essenziali per iniziare a gestire il circolo.',
		details: 'Nessun costo.',
		features: ['Gestione delle gare', 'Caricamento foto del circolo', 'Recensioni e commenti'],
		cta: 'Registrati gratuitamente',
		featured: false,
	},
	{
		name: 'Pro',
		price: '€59',
		description: 'Tutte le funzionalità della piattaforma in un unico piano.',
		details: 'Fatturazione mensile.',
		features: [
			'Tutte le funzionalità della piattaforma',
			'Controllo in tempo reale dei giocatori',
			'Gestione delle convenzioni tra circoli',
			'Gestione dei percorsi e punti di interesse',
			'Moderazione recensioni',
			'Caricamento foto del circolo',
			'Inserimento delle gare',
			'Anagrafica dei giocatori',
			'Confronto tra circoli e statistiche',
		],
		cta: 'Acquista ora',
		featured: true,
		badge: 'Abbonamento annuale a 499€',
	},
];

const testimonials = [
	{
		name: 'Alessandro Crabbia',
		role: 'Giocatore',
		quote: 'Seguo la gara in tempo reale dal telefono: vedo chi è in campo, la posizione e l’avanzamento senza dover chiedere in giro. Finalmente tutto sotto controllo.',
	},
	{
		name: 'Andrea Bolzan',
		role: 'Giocatore',
		quote: 'Dall’app trovo subito i circoli convenzionati e le condizioni per giocare. Organizzare una partita fuori dal mio circolo è diventato molto più semplice.',
	},
	{
		name: 'Paolo De Antoni',
		role: 'Giocatore',
		quote: 'Leggo le recensioni e guardo le foto prima di scegliere dove giocare. È utile per capire com’è il percorso e cosa aspettarmi.',
	},
	{
		name: 'Francesco di Nisio',
		role: 'Giocatore',
		quote: 'Mi iscrivo alle gare e consulto risultati e statistiche direttamente dall’app. Il mio profilo da giocatore è sempre aggiornato.',
	},
];

const faqs = [
	{
		q: 'Che cos’è Golfista?',
		a: 'Golfista è la piattaforma che aiuta circoli e golfisti a gestire gare, percorsi, convenzioni e contenuti in un unico posto, con il controllo dei giocatori in tempo reale.',
	},
	{
		q: 'A chi è rivolta la piattaforma?',
		a: 'A circoli, gestori e golfisti che vogliono organizzare le attività del circolo e seguire le gare in modo semplice, anche da mobile.',
	},
	{
		q: 'Quanti giorni dura la prova gratuita?',
		a: 'La prova gratuita dura 14 giorni. Puoi esplorare le funzionalità della piattaforma senza impegno.',
	},
	{
		q: 'Come posso cancellare il rinnovo?',
		a: 'Puoi disattivare il rinnovo in qualsiasi momento dalle impostazioni del tuo account sulla piattaforma. L’accesso resta attivo fino alla scadenza del periodo già pagato.',
	},
	{
		q: 'È previsto un rimborso?',
		a: 'No, non è previsto alcun rimborso. In caso di disdetta, l’abbonamento resta attivo fino alla fine del mese in corso.',
	},
	{
		q: 'Golfista è affiliata a federazioni o altre organizzazioni?',
		a: 'No. Golfista non è affiliata a nessun’altra società, organizzazione o federazione.',
	},
	{
		q: 'Posso seguire una gara in tempo reale?',
		a: 'Sì. La mappa mostra i giocatori in campo e il loro avanzamento, così puoi seguire la gara senza continue telefonate.',
	},
	{
		q: 'Quali funzionalità include il piano Pro?',
		a: 'Il piano Pro include tutte le funzionalità della piattaforma: controllo dei giocatori, convenzioni tra circoli, percorsi e punti di interesse, gare, foto, recensioni, anagrafica e statistiche.',
	},
	{
		q: 'I dati del circolo e dei giocatori sono al sicuro?',
		a: 'Sì. Adottiamo misure tecniche e organizzative per proteggere i dati e limitare l’accesso alle sole persone autorizzate.',
	},
	{
		q: 'Serve installare un’app?',
		a: 'Puoi usare Golfista dal browser oppure dall’app mobile, così hai le informazioni del circolo sempre a portata di mano.',
	},
];

const allFaqs = faqs;

---

<div class="lp">
	<section class="lp-hero" id="overview" aria-labelledby="lp-hero-title">
		<div class="lp-hero-glow" aria-hidden="true"></div>
		<div class="lp-hero-grid-lines" aria-hidden="true"></div>

		<div class="lp-container lp-hero-inner">
			<div class="lp-hero-copy">

				<h1 id="lp-hero-title">Gestisci<span class="lp-rotator" data-rotator-words="i giocatori|le convenzioni|le foto delle gare|le recensioni|le news|le statistiche" aria-hidden="true"><span class="lp-mark lp-rotator-word">i giocatori</span></span><span class="sr-only">i giocatori</span><br />del tuo circolo</h1>
				<p class="lp-hero-sub">La piattaforma semplice e completa per gestire giocatori, convenzioni e contenuti del circolo, ovunque ti trovi.</p>
				<div class="lp-actions">
					<a class="lp-btn lp-btn-cream" href="#pricing">Inizia ora <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
				</div>
				<p class="lp-note"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Nessuna carta di credito richiesta - 14 giorni di prova gratuita.</p>
			</div>

			<div class="lp-course">
				<div class="lp-map-panel">
					<div id="lp-course-map" class="lp-map" role="application" aria-label="Mappa 3D dell'Asolo Golf Club con i giocatori in movimento"></div>
				</div>

				<div class="lp-course-stats" aria-label="Statistiche del campo">
					<article class="lp-course-stat">
						<span class="lp-course-stat-icon"><i class="fa-solid fa-people-group" aria-hidden="true"></i></span>
						<p>Totale giocatori in campo <span class="lp-live-badge">In tempo reale</span></p>
						<strong>5</strong>
						<small>In gioco ora</small>
					</article>
					<article class="lp-course-stat">
						<span class="lp-course-stat-icon"><i class="fa-solid fa-clock" aria-hidden="true"></i></span>
						<p>Media durata di un giro</p>
						<strong>4h 12m</strong>
						<small>18 buche</small>
					</article>
					<article class="lp-course-stat">
						<span class="lp-course-stat-icon"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i></span>
						<p>Buca più lenta</p>
						<strong>#5</strong>
						<small>26 minuti</small>
					</article>
					<article class="lp-course-stat">
						<span class="lp-course-stat-icon"><i class="fa-solid fa-bolt" aria-hidden="true"></i></span>
						<p>Buca più veloce</p>
						<strong>#12</strong>
						<small>14 minuti</small>
					</article>
				</div>
			</div>
		</div>
	</section>

	{brandCircoli.length > 0 && (
		<section class="lp-brands" aria-label="Circoli presenti su Golfista">
			<div class="lp-container">
				<h2>Alcuni dei circoli su Golfista</h2>
				<div class="lp-brand-marquee">
					<div class="lp-brand-track" data-brand-track>
						{[0, 1].map((copy) => (
							<div class="lp-brand-group" aria-hidden={copy === 1 ? 'true' : undefined}>
								{brandCircoli.map((circolo) => (
									<a
										class="lp-brand"
										href={circolo.href}
										aria-label={circolo.nome}
										tabindex={copy === 1 ? -1 : undefined}
										aria-hidden={copy === 1 ? 'true' : undefined}
									>
										<span class="lp-brand-logo">
											<img src={circolo.logo} alt="" loading="lazy" decoding="async" />
										</span>
										<span class="lp-brand-name">{circolo.nome}</span>
									</a>
								))}
							</div>
						))}
					</div>
				</div>
			</div>
		</section>
	)}

	<section class="lp-section lp-features" id="features" aria-labelledby="lp-features-title">
		<div class="lp-container">
			<header class="lp-section-head">
				<p class="lp-badge lp-badge-dark"><span class="lp-dot lp-dot-green"></span> Funzionalità principali</p>
				<h2 id="lp-features-title">Il tuo circolo sempre <span class="lp-mark-dark">sotto controllo</span></h2>
				<p>Tutto ciò che serve per gestire giocatori, convenzioni e contenuti del circolo in un’unica piattaforma.</p>
			</header>

			<div class="lp-beta-grid" id={!showDemoVideo ? 'how_it_works' : undefined}>
				{featureCards.map((card) => (
					<article class={`lp-beta-card lp-beta-${card.tone}`}>
						<div class="lp-beta-copy">
							<h3>{card.kicker}</h3>
							<p>{card.text}</p>
							{card.cta && <a class="lp-text-link" href={card.href}>{card.cta} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}
						</div>
						<div class="lp-beta-media">
							<picture>
								{card.mobileImage && <source media="(max-width: 720px)" srcset={card.mobileImage} width="1440" height="828" />}
								<img src={card.image} alt={card.imageAlt} width={card.imageWidth} height={card.imageHeight} loading="lazy" decoding="async" />
							</picture>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	{showDemoVideo && <section class="lp-how" id="how_it_works" aria-labelledby="lp-how-title">
		<div class="lp-container">
			<h2 class="sr-only" id="lp-how-title">Come funziona</h2>
			<div class="lp-video-panel">
				<video
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					poster="/lexend/lexend_vid_home-6.webp"
					aria-label="Panoramica video di Golfista"
				>
					<source src="/lexend/lexend_2.webm" type="video/webm" />
				</video>
			</div>
		</div>
	</section>}

	<section class="lp-key-section" aria-labelledby="lp-key-title">
		<div class="lp-container">
			<header class="lp-key-head">
				<p class="lp-badge lp-badge-dark"><span class="lp-dot lp-dot-green"></span> Altre funzionalità della piattaforma</p>
				<h2 class="sr-only" id="lp-key-title">Altre funzionalità della piattaforma</h2>
				<p>Strumenti semplici e completi per gestire ogni aspetto del circolo, dai percorsi alle gare fino ai contenuti e ai dati dei giocatori.</p>
			</header>

			<div class="lp-key-grid">
				{keyFeatures.map((feature) => (
					<a class="lp-key" href={feature.href} target={feature.href.startsWith('http') ? '_blank' : undefined} rel={feature.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
						<span class="lp-key-icon"><i class={`fa-solid ${feature.icon}`} aria-hidden="true"></i></span>
						<strong>{feature.title}</strong>
						<p>{feature.text}</p>
						<i class="fa-solid fa-arrow-up-right lp-key-arrow" aria-hidden="true"></i>
					</a>
				))}
			</div>

			<div class="lp-view-row">
				<a class="lp-btn lp-btn-dark" href="/gestionale">Vedi tutte le funzionalità <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
			</div>


		</div>
	</section>

	<section class="lp-pricing" id="pricing" aria-labelledby="lp-pricing-title">
		<div class="lp-container">
			<header class="lp-section-head lp-section-head-light">
				<p class="lp-badge lp-badge-on-dark"><span class="lp-dot"></span> Prezzi</p>
				<h2 id="lp-pricing-title">Tutto questo al prezzo di <span class="lp-mark">un green fee al mese</span>!</h2>
				<p>Nessun costo aggiuntivo. Nessun costo nascosto.</p>
			</header>

			<div class="lp-plans">
				{plans.map((plan) => (
					<article class={`lp-plan ${plan.featured ? 'is-featured' : ''}`}>
						{plan.badge && <span class="lp-plan-badge">{plan.badge}</span>}
						<p class="lp-plan-name">{plan.name}</p>
						<div class="lp-plan-price"><strong>{plan.price}</strong><span>/ mese</span></div>
						<p class="lp-plan-desc">{plan.description}</p>
						<a class="lp-plan-btn" href="https://manager.golfista.app" target="_blank" rel="noopener noreferrer">{plan.cta}</a>
						<p class="lp-plan-details">{plan.details}</p>
						<ul>
							{plan.features.map((feature) => <li><i class="fa-solid fa-check" aria-hidden="true"></i>{feature}</li>)}
						</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="lp-testimonials" id="clients_feedback" aria-labelledby="lp-testimonials-title">
		<div class="lp-container">
			<header class="lp-section-head">
				<p class="lp-badge lp-badge-dark"><span class="lp-dot lp-dot-green"></span> Giocatori che usano l'app</p>
				<h2 id="lp-testimonials-title">Cosa dicono di noi <span class="lp-mark-dark">i golfisti</span></h2>
			</header>

			<div class="lp-quotes">
				{testimonials.map(({ name, role, quote }) => (
					<article class="lp-quote">
						<div class="lp-stars" aria-label="5 stelle su 5">
							{Array.from({ length: 5 }, () => <img src="/lexend/star-red.svg" alt="" aria-hidden="true" />)}
						</div>
						<p>“{quote}”</p>
						<footer>
							<span class="lp-quote-avatar">{name.split(' ').map((part) => part[0]).join('')}</span>
							<span><strong>{name}</strong><small>{role}</small></span>
						</footer>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="lp-faq" aria-labelledby="lp-faq-title">
		<div class="lp-container lp-faq-grid">
			<div class="lp-faq-copy">
				<p class="lp-badge lp-badge-dark"><span class="lp-dot lp-dot-green"></span> FAQ</p>
				<h2 id="lp-faq-title">Domande frequenti</h2>
				<p>Tutto quello che c’è da sapere su Golfista, abbonamenti e funzionalità della piattaforma.</p>
				<a class="lp-btn lp-btn-dark" href="#pricing">Scopri i piani</a>
			</div>
			<div class="lp-faq-list">
				{allFaqs.map((faq) => (
					<details>
						<summary>{faq.q}<span aria-hidden="true"><i class="fa-solid fa-plus"></i></span></summary>
						<p>{faq.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<section class="lp-cta" aria-labelledby="lp-cta-title">
		<div class="lp-container lp-cta-grid">
			<div class="lp-cta-copy">
				<h2 id="lp-cta-title">Tutto il tuo circolo, in un’unica app.</h2>
				<p>Inizia la prova gratuita di 14 giorni. Disdici quando vuoi.</p>
				<a class="lp-btn lp-btn-cream" href="#pricing">Inizia ora <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
			</div>
			<div class="lp-cta-visual">
				<img src="/images/features/dashboard.webp" alt="Dashboard Golfista con statistiche e confronto tra circoli" width="1440" height="811" loading="lazy" decoding="async" />
			</div>
		</div>
	</section>
</div>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.lp {
		--header-green: #00ec10;
		color: var(--lex-dark);
		background: #fff;
	}

	.lp > section {
		width: 100%;
		margin-inline: 0;
	}

	.lp-container {
		width: min(1240px, calc(100% - 40px));
		margin-inline: auto;
	}

	.lp-hero {
		position: relative;
		overflow: hidden;
		margin-top: -104px;
		padding: 178px 0 92px;
		background: var(--lex-dark);
		color: var(--lex-cream);
	}

	.lp-hero-glow {
		position: absolute;
		inset: -30% -10% auto auto;
		width: 70vw;
		height: 70vw;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(20, 113, 91, 0.34) 0%, rgba(20, 113, 91, 0) 68%);
		pointer-events: none;
	}

	.lp-hero-grid-lines {
		position: absolute;
		inset: 0;
		opacity: 0.18;
		background-image:
			linear-gradient(rgba(241, 226, 222, 0.08) 1px, transparent 1px),
			linear-gradient(90deg, rgba(241, 226, 222, 0.08) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: linear-gradient(to bottom, #000 0%, transparent 82%);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 82%);
		pointer-events: none;
	}

	.lp-hero-inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 48px;
	}

	.lp-hero-copy {
		width: 100%;
		max-width: 1100px;
		text-align: center;
	}

	.lp-badge {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		margin: 0 0 26px;
		padding: 8px 14px;
		border: 1px solid rgba(241, 226, 222, 0.2);
		border-radius: 999px;
		color: rgba(241, 226, 222, 0.78);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.1em;
		line-height: 1;
		text-transform: uppercase;
	}

	.lp-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--lex-cream);
		box-shadow: 0 0 0 4px rgba(241, 226, 222, 0.1);
	}

	.lp-hero h1 {
		margin: 0 auto;
		color: var(--lex-cream);
		font-size: clamp(48px, 5.5vw, 78px);
		font-weight: 600;
		line-height: 1.03;
		letter-spacing: -0.06em;
		text-wrap: balance;
	}

	.lp-mark,
	.lp-mark-dark {
		display: inline-block;
		padding: 0 0.14em;
		border-radius: 10px;
		background: var(--header-green);
		color: #000;
		transform: rotate(-1.5deg);
	}

	.lp-mark-dark {
