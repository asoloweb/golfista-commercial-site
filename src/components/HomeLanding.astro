	@media (prefers-reduced-motion: reduce) {
		.lp-rotator-word {
			transition: none;
		}

		.lp-live-badge,
		.lp-live-badge::before {
			animation: none;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import mapboxgl from 'mapbox-gl';
	import { ASOLO_GOLF_CLUB, MAPBOX_PUBLIC_TOKEN, MAPBOX_STYLE_URL } from '../lib/mapbox';

	type RoutePoint = [number, number];
	type Movable = {
		name: string;
		image: string;
		position: string;
		cart?: string;
		route: RoutePoint[];
		duration: number;
		offset: number;
	};

	const rotator = document.querySelector<HTMLElement>('[data-rotator-words]');
	const rotatorWord = rotator?.querySelector<HTMLElement>('.lp-rotator-word');
	const rotatorWords = rotator?.dataset.rotatorWords?.split('|').filter(Boolean) ?? [];

	if (rotator && rotatorWord && rotatorWords.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let rotatorIndex = 0;

		window.setInterval(() => {
			rotator.classList.add('is-leaving');
			window.setTimeout(() => {
				rotatorIndex = (rotatorIndex + 1) % rotatorWords.length;
				rotatorWord.textContent = rotatorWords[rotatorIndex];
				rotator.classList.remove('is-leaving');
				rotator.classList.add('is-entering');
				window.requestAnimationFrame(() => {
					window.requestAnimationFrame(() => rotator.classList.remove('is-entering'));
				});
			}, 220);
		}, 2600);
	}

	const brandTrack = document.querySelector<HTMLElement>('[data-brand-track]');

	if (brandTrack && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		gsap.to(brandTrack, {
			xPercent: -50,
			duration: 42,
			ease: 'none',
			repeat: -1,
		});
	}

	const mapElement = document.getElementById('lp-course-map');

	if (mapElement && MAPBOX_PUBLIC_TOKEN) {
		mapboxgl.accessToken = MAPBOX_PUBLIC_TOKEN;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const isCompact = window.matchMedia('(max-width: 720px)').matches;
		const map = new mapboxgl.Map({
			container: mapElement,
			style: MAPBOX_STYLE_URL,
			center: [ASOLO_GOLF_CLUB.lng, ASOLO_GOLF_CLUB.lat],
			zoom: isCompact ? 15.5 : 16.2,
			pitch: isCompact ? 48 : 62,
			bearing: -22,
			antialias: true,
			locale: {
				'AttributionControl.ToggleAttribution': 'Migliora questa mappa',
				'FullscreenControl.Enter': 'Entra a schermo intero',
				'FullscreenControl.Exit': 'Esci da schermo intero',
				'GeolocateControl.FindMyLocation': 'Trova la mia posizione',
				'GeolocateControl.LocationNotAvailable': 'Posizione non disponibile',
				'LogoControl.Title': 'Logo Mapbox',
				'Map.Title': 'Mappa',
				'NavigationControl.ResetBearing': 'Ripristina orientamento',
				'NavigationControl.ZoomIn': 'Aumenta zoom',
				'NavigationControl.ZoomOut': 'Riduci zoom',
				'ScrollZoomBlocker.CtrlMessage': 'Usa Ctrl + scroll per lo zoom della mappa',
				'ScrollZoomBlocker.CmdMessage': 'Usa ⌘ + scroll per lo zoom della mappa',
				'TouchPanBlocker.Message': 'Usa due dita per spostare la mappa',
			},
			cooperativeGestures: true,
			scrollZoom: false,
			boxZoom: false,
			doubleClickZoom: false,
			touchZoomRotate: false,
		});

		const movers: Movable[] = [
			{
				name: 'Marco',
				image: '/images/golf/golfer-swing.jpg',
				position: 'Green #9',
				route: [
					[-0.0028, 0.001],
					[-0.0021, 0.0018],
					[-0.0008, 0.0019],
					[0.0005, 0.0015],
					[0.0014, 0.0007],
					[0.0009, -0.0003],
					[-0.0004, -0.0008],
					[-0.0018, -0.0005],
					[-0.0027, 0.0002],
				],
				duration: 54,
				offset: 0.08,
			},
			{
				name: 'Giulia',
				image: '/images/golf/golf-players-together.jpg',
				position: 'Fairway #4',
				route: [
					[0.0018, 0.0014],
					[0.0027, 0.0006],
					[0.0024, -0.0007],
					[0.0012, -0.0012],
					[0.0001, -0.0008],
					[-0.0002, 0.0002],
					[0.0007, 0.001],
				],
				duration: 62,
				offset: 0.42,
			},
			{
				name: 'Luca',
				image: '/images/golf/slide-manager-golfer.jpg',
				position: 'Tee #12',
				route: [
					[-0.0016, -0.001],
					[-0.0004, -0.0015],
					[0.0008, -0.0018],
					[0.0017, -0.0012],
					[0.0012, -0.0002],
					[0.0002, 0.0001],
					[-0.0009, -0.0003],
					[-0.0018, -0.0007],
				],
				duration: 47,
				offset: 0.66,
			},
			{
				name: 'Sofia',
				image: '/images/golf/golfer-sunset.jpg',
				position: 'Green #16',
				route: [
					[-0.003, -0.0004],
					[-0.0022, -0.0012],
					[-0.0007, -0.0014],
					[0.0004, -0.001],
					[0.0009, -0.0002],
					[0.0002, 0.0006],
					[-0.001, 0.0008],
					[-0.0022, 0.0004],
				],
				duration: 58,
				offset: 0.24,
			},
			{
				name: 'Paolo',
				image: '/images/golf/golf-carts-sunset.jpg',
				position: 'Fairway #7',
				cart: '22',
				route: [
					[-0.0024, 0.0022],
					[-0.0008, 0.0025],
					[0.0008, 0.0021],
					[0.0018, 0.0012],
					[0.0011, 0.0003],
					[-0.0005, 0.0002],
					[-0.002, 0.0009],
				],
				duration: 70,
				offset: 0.55,
			},
		];

		const routeLength = (route: RoutePoint[]) => {
			let length = 0;
			for (let index = 0; index < route.length; index += 1) {
				const [x1, y1] = route[index];
				const [x2, y2] = route[(index + 1) % route.length];
				length += Math.hypot(x2 - x1, y2 - y1);
			}
			return length;
		};

		const pointOnRoute = (route: RoutePoint[], length: number, progress: number): [number, number] => {
			let remaining = (((progress % 1) + 1) % 1) * length;
			for (let index = 0; index < route.length; index += 1) {
				const [x1, y1] = route[index];
				const [x2, y2] = route[(index + 1) % route.length];
				const segment = Math.hypot(x2 - x1, y2 - y1);
				if (remaining <= segment) {
					const ratio = segment > 0 ? remaining / segment : 0;
					return [ASOLO_GOLF_CLUB.lng + x1 + (x2 - x1) * ratio, ASOLO_GOLF_CLUB.lat + y1 + (y2 - y1) * ratio];
				}
				remaining -= segment;
			}
			return [ASOLO_GOLF_CLUB.lng + route[0][0], ASOLO_GOLF_CLUB.lat + route[0][1]];
		};

		const createAvatar = (avatar: Movable) => {
			const element = document.createElement('div');
			element.className = 'lp-map-avatar';

			const image = document.createElement('img');
			image.src = avatar.image;
			image.alt = '';
			image.loading = 'lazy';
			image.decoding = 'async';

			const name = document.createElement('span');
			name.className = 'lp-map-avatar-name';
			name.textContent = avatar.name;

			element.append(image, name);

			if (avatar.cart) {
				const cart = document.createElement('span');
				cart.className = 'lp-map-avatar-cart';
				cart.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14V8h9l3 6"></path><path d="M3 14h14"></path><circle cx="8" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle><path d="M8 8V4h6"></path></svg><span>${avatar.cart}</span>`;
				element.append(cart);
			}

			return element;
		};

		const createPlayerPopupContent = (avatar: Movable) => {
			const card = document.createElement('div');
			card.className = 'lp-map-popup-card';
			card.setAttribute('role', 'dialog');
			card.setAttribute('aria-label', `Dettagli di ${avatar.name}`);

			const photo = document.createElement('img');
			photo.className = 'lp-map-popup-photo';
			photo.src = avatar.image;
			photo.alt = '';
			photo.loading = 'lazy';
			photo.decoding = 'async';

			const body = document.createElement('div');
			body.className = 'lp-map-popup-body';

			const eyebrow = document.createElement('span');
			eyebrow.className = 'lp-map-popup-eyebrow';
			eyebrow.textContent = 'Giocatore in campo';

			const name = document.createElement('strong');
			name.className = 'lp-map-popup-name';
			name.textContent = avatar.name;

			const position = document.createElement('span');
			position.className = 'lp-map-popup-position';
			position.innerHTML = `<i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>${avatar.position}</span>`;

			body.append(eyebrow, name, position);

			if (avatar.cart) {
				const cart = document.createElement('span');
				cart.className = 'lp-map-popup-cart';
				cart.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14V8h9l3 6"></path><path d="M3 14h14"></path><circle cx="8" cy="18" r="2"></circle><circle cx="17" cy="18" r="2"></circle><path d="M8 8V4h6"></path></svg><span>Cart #${avatar.cart}</span>`;
				body.append(cart);
			}

			card.append(photo, body);
			return card;
		};

		let animationFrame = 0;
		let lastFrame = 0;
		const startedAt = performance.now();

		map.on('load', () => {
			map.setConfigProperty('basemap', 'showRoadLabels', false);
			map.setConfigProperty('basemap', 'showPlaceLabels', false);
			map.setConfigProperty('basemap', 'showPointOfInterestLabels', false);
			map.setConfigProperty('basemap', 'showTransitLabels', false);
			map.setConfigProperty('basemap', 'show3dObjects', true);
			map.setConfigProperty('basemap', 'lightPreset', 'day');

			if (!map.getSource('lp-terrain')) {
				map.addSource('lp-terrain', {
					type: 'raster-dem',
					url: 'mapbox://mapbox.mapbox-terrain-dem-v1',
					tileSize: 256,
					maxzoom: 14,
				});
			}
			map.setTerrain({ source: 'lp-terrain', exaggeration: 1.3 });

			let playerPopup: mapboxgl.Popup | null = null;
			let playerPopupName: string | null = null;

			const openPlayerPopup = (avatar: Movable, marker: mapboxgl.Marker) => {
				playerPopup?.remove();
				const popup = new mapboxgl.Popup({
					className: 'lp-map-popup',
					closeButton: true,
					closeOnClick: true,
					offset: [0, -34],
					maxWidth: '280px',
				})
					.setLngLat(marker.getLngLat())
					.setDOMContent(createPlayerPopupContent(avatar))
					.addTo(map);

				playerPopup = popup;
				playerPopupName = avatar.name;
				popup.on('close', () => {
					if (playerPopup === popup) {
						playerPopup = null;
						playerPopupName = null;
					}
				});
			};

			const markers = movers.map((avatar, index) => {
				const length = routeLength(avatar.route);
				const element = createAvatar(avatar);
				const marker = new mapboxgl.Marker({ element, anchor: 'center' })
					.setLngLat(pointOnRoute(avatar.route, length, avatar.offset))
					.addTo(map);

				element.setAttribute('role', 'button');
				element.setAttribute('tabindex', '0');
				element.setAttribute(
					'aria-label',
					`${avatar.name}, ${avatar.position}${avatar.cart ? `, cart ${avatar.cart}` : ''}. Apri dettagli`,
				);
				const open = () => openPlayerPopup(avatar, marker);
				element.addEventListener('click', (event) => {
					event.stopPropagation();
					open();
				});
				element.addEventListener('keydown', (event) => {
					if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						open();
					}
				});

				return { avatar, length, marker, phase: index * 0.13 };
			});

			if (reduceMotion) return;

			const animate = (now: number) => {
				if (!document.hidden && now - lastFrame > 60) {
					lastFrame = now;
					const elapsed = (now - startedAt) / 1000;
					for (const mover of markers) {
						const progress = elapsed / mover.avatar.duration + mover.avatar.offset + mover.phase;
						mover.marker.setLngLat(pointOnRoute(mover.avatar.route, mover.length, progress));
					}
					if (playerPopup && playerPopupName) {
						const selected = markers.find((mover) => mover.avatar.name === playerPopupName);
						if (selected) playerPopup.setLngLat(selected.marker.getLngLat());
					}
				}
				animationFrame = window.requestAnimationFrame(animate);
			};

			animationFrame = window.requestAnimationFrame(animate);
		});

		window.addEventListener(
			'pagehide',
			() => {
				window.cancelAnimationFrame(animationFrame);
				map.remove();
			},
			{ once: true },
		);
	}
</script>
