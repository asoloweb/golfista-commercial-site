---
import { Image } from 'astro:assets';
import { directusAssetUrl } from '../lib/directus';

interface Props {
	item: string;
	titolo?: string;
	sottotitolo?: string;
	paragrafo?: string;
	href?: string;
	label?: string;
	immagine?: string;
	inverti?: boolean;
	background_color?: string;
}

const { 
	item, 
	titolo = '', 
	sottotitolo = '', 
	paragrafo = '', 
	href = '', 
	label = '', 
	immagine = '',
	inverti = false,
	background_color = ''
} = Astro.props;

function resolveImageSrc(value: string) {
	if (!value) return '';
	return directusAssetUrl(value, { format: 'webp', quality: 80, width: 1200, height: 900, fit: 'cover' });
}
---

<div
	data-aos="fade-up"
     data-aos-duration="1500"
	class={`hero_block${inverti ? ' hero_block_inverted' : ''}`}
	style={background_color ? `background-color: ${background_color};` : undefined}
>
	{immagine && (
		<div class="colonna colonna_immagine">
			<Image
				class="hero_image"
				data-aos="fade-up"
				data-aos-duration="2000"
				src={resolveImageSrc(immagine)}
				alt={sottotitolo || titolo}
				width={1200}
				height={800}
			/>
		</div>
	)}
	<div class="colonna colonna_testo">
		{titolo && <div class="title" set:html={titolo} />}
		{sottotitolo && <h3 set:html={sottotitolo} />}
		{paragrafo && <div class="hero_text" set:html={paragrafo} />}
		{label && href && (
			<a class="hero_button MainButton" href={href}>
				{label}
			</a>
		)}
	</div>
</div>

<style>
	.hero_block {
		padding: 40px;
		display: flex;
		gap: 40px;
		border-radius: var(--radius-lg);
		max-width: var(--max-width);
		margin: auto;
		margin-bottom: 40px;
		background-color: var(--surface);
		box-shadow: var(--shadow-card);
	}
	.colonna {
		flex: 1;
	}

	.hero_block_inverted {
		flex-direction: row-reverse;
	}

	.colonna_testo {
		display: flex;
		flex-direction: column;
		justify-content: center;	
	}

	.colonna_testo h3 {
		font-size: 22px;
		margin: 0;
		margin-bottom: 25px;
	}

	.colonna_testo .title {
		font-size: clamp(46px, 5.2vw, 68px);
		font-family: var(--font-heading);
		line-height: .95;
		font-weight: bold;
		margin-top: 0;
		margin-bottom: 20px;
		font-weight: 500;
	}

	.colonna_immagine img {
		object-fit: cover;
		height: 100%;
		border-radius: 22px;
	}

	.hero_button {
		display: inline-block;
		color: var(--secondary);
		text-decoration: none;
	}
	.hero_text {
		margin: 0 0 30px;
		line-height: 24px;
		font-size: 19px;
		font-weight: 300;
	}
	.hero_image {
		max-width: 100%;
		height: auto;
		display: block;
	}

	@media (max-width: 980px) {
		.hero_block {
			padding: 30px;
			gap: 28px;
		}
		.colonna_testo .title {
			font-size: 52px;
			line-height: 45px;
		}
	}

	@media (max-width: 640px) {
		.hero_block,
		.hero_block_inverted {
			flex-direction: column-reverse;
			margin-left: 10px;
			margin-right: 10px;
			padding: 24px 20px;
		}

		.colonna_testo .title {
			font-size: 46px;
		}
	}
</style>
