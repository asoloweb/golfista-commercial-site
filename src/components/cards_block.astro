---
import { directusAssetUrl } from '../lib/directus';

interface PageRef {
	id?: number;
	slug?: string;
}

interface SingleCard {
	id?: number;
	titolo_card?: string;
	descrizione?: string;
	immagine?: string;
	icon_url?: string;
	href?: string;
	link?: PageRef | number | null;
}

interface CardRelation {
	single_card_id?: SingleCard | number | null;
}

interface Props {
	titolo?: string;
	card?: CardRelation[] | SingleCard[];
	compactMedia?: boolean;
}

const { titolo = '', card = [], compactMedia = false } = Astro.props;

function resolveImageSrc(value: string | undefined, compact = false) {
	if (!value) return '';
	if (compact) {
		return directusAssetUrl(value, { format: 'webp', quality: 80 });
	}
	return directusAssetUrl(value, { format: 'webp', quality: 76, width: 640, height: 420, fit: 'cover' });
}

function normalizeCards(input: CardRelation[] | SingleCard[]) {
	if (!Array.isArray(input)) return [];
	return input
		.map((entry) => {
			if (!entry || typeof entry !== 'object') return null;
			if ('single_card_id' in entry) {
				return entry.single_card_id && typeof entry.single_card_id === 'object'
					? (entry.single_card_id as SingleCard)
					: null;
			}
			if ('titolo_card' in entry || 'descrizione' in entry || 'immagine' in entry || 'icon_url' in entry || 'href' in entry) {
				return entry as SingleCard;
			}
			return null;
		})
		.filter((entry): entry is SingleCard => Boolean(entry));
}

function getCardHref(card: SingleCard) {
	if (card.href) return card.href;
	if (card.link && typeof card.link === 'object' && card.link.slug) {
		return card.link.slug === 'home' ? '/' : `/${card.link.slug}`;
	}
	return '';
}

const cards = normalizeCards(card);
---

{cards.length > 0 && (
	<section class={`cards_block ${compactMedia ? 'cards_block_compact_media' : ''}`} data-aos="fade-up" data-aos-duration="1500">
		<div class="cards_block_inner">
			{titolo && <h2 class="cards_block_title" set:html={titolo} />}

			<div class="cards_grid">
				{cards.map((single) => {
					const href = getCardHref(single);
					const Tag = href ? 'a' : 'div';
					const isIcon = Boolean(single.icon_url);
					const imageSrc = single.icon_url || resolveImageSrc(single.immagine, compactMedia);

					return (
						<Tag class="cards_card" href={href || undefined}>
							{imageSrc && (
								<div class={`cards_card_media ${isIcon ? 'cards_card_icon' : ''}`}>
									<img src={imageSrc} alt={single.titolo_card || ''} loading="lazy" />
								</div>
							)}
							{single.titolo_card && <h3 class="cards_card_title" set:html={single.titolo_card} />}
							{single.descrizione && <p class="cards_card_description" set:html={single.descrizione} />}
						</Tag>
					);
				})}
			</div>
		</div>
	</section>
)}

<style>
	.cards_block {
		margin-bottom: 40px;
		padding: 0 20px;
	}

	.cards_block_inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 48px;
		border-radius: var(--radius-lg);
		background-color: var(--surface);
		box-shadow: var(--shadow-card);
	}

	.cards_block_title {
		margin: 0 0 32px;
		color: #000;
		font-size: clamp(42px, 6vw, 64px);
		line-height: .95;
	}

	.cards_block_title :global(span) {
		color: var(--primary);
	}

	.cards_block_inner :global(span) {
		color: var(--primary);
	}

	.cards_grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		margin-bottom: 0;
	}

	.cards_card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 26px 20px;
		background: var(--surface-muted);
		border: 1px solid var(--border);
		border-radius: 22px;
		color: var(--nero);
		transition: transform 200ms ease, box-shadow 200ms ease;
		min-height: 100%;
		box-shadow: none;
		text-align: center;
		align-items: center;
		min-height: 250px;
		justify-content: center;
	}

	a.cards_card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
	}

	.cards_card_title {
		margin: 4px 0 0;
		font-size: 22px;
		line-height: 24px;
	}

	.cards_card_description {
		margin: 4px 0 0;
		font-size: 16px;
		line-height: 22px;
	}

	.cards_card_media img {
		width: 84px;
		height: 84px;
		object-fit: contain;
	}

	.cards_card_icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 88px;
		height: 88px;
		margin-bottom: 8px;
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 12px 22px rgba(0, 236, 16, 0.24);
	}

	.cards_card_icon img {
		display: block;
		width: 42px;
		height: 42px;
		object-fit: contain;
		filter: brightness(0);
	}

	.cards_block_compact_media .cards_card_media img {
		height: 120px;
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	@media (max-width: 1024px) {
		.cards_grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.cards_block {
			padding: 0 10px;
		}

		.cards_block_inner {
			padding: 32px 20px;
		}

		.cards_grid {
			grid-template-columns: 1fr;
		}
	}
</style>
