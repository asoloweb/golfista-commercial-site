---

interface PageRef {
	id?: number;
	slug?: string;
}

interface SingleCard {
	id?: number;
	titolo_card?: string;
	descrizione?: string;
	immagine?: string;
	icon_url?: string;
	href?: string;
	link?: PageRef | number | null;
}

interface CardRelation {
	single_card_id?: SingleCard | number | null;
}

interface Props {
	titolo?: string;
	card?: CardRelation[] | SingleCard[];
	compactMedia?: boolean;
}

const { titolo = '', card = [], compactMedia = false } = Astro.props;

function resolveImageSrc(value: string | undefined) {
	if (!value) return '';
	return value;
}

function normalizeCards(input: CardRelation[] | SingleCard[]) {
	if (!Array.isArray(input)) return [];
	return input
		.map((entry) => {
			if (!entry || typeof entry !== 'object') return null;
			if ('single_card_id' in entry) {
				return entry.single_card_id && typeof entry.single_card_id === 'object'
					? (entry.single_card_id as SingleCard)
					: null;
			}
			if ('titolo_card' in entry || 'descrizione' in entry || 'immagine' in entry || 'icon_url' in entry || 'href' in entry) {
				return entry as SingleCard;
			}
			return null;
		})
		.filter((entry): entry is SingleCard => Boolean(entry));
}

function getCardHref(card: SingleCard) {
	if (card.href) return card.href;
	if (card.link && typeof card.link === 'object' && card.link.slug) {
		return card.link.slug === 'home' ? '/' : `/${card.link.slug}`;
	}
	return '';
}

const cardIconClasses: Record<string, string> = {
	'1': 'fa-golf-ball-tee',
	'2': 'fa-bullhorn',
	'3': 'fa-mobile-screen-button',
	'4': 'fa-phone',
	'5': 'fa-envelope',
	'6': 'fa-whatsapp',
	'7': 'fa-map-location-dot',
	'8': 'fa-location-dot',
	'9': 'fa-handshake',
	'10': 'fa-star',
	'11': 'fa-camera',
	'12': 'fa-flag',
	'13': 'fa-cloud-sun',
	'14': 'fa-code-compare',
	'15': 'fa-chart-line',
	'16': 'fa-newspaper',
	'17': 'fa-trophy',
};

function getCardIconClass(card: SingleCard) {
	const id = card.id != null ? String(card.id) : '';
	return cardIconClasses[id] || '';
}

const cards = normalizeCards(card);
---

{cards.length > 0 && (
	<section class={`cards_block ${compactMedia ? 'cards_block_compact_media' : ''}`}>
		<div class="cards_block_inner">
			{titolo && <h2 class="cards_block_title" set:html={titolo} />}

			<div class="cards_grid">
				{cards.map((single) => {
					const href = getCardHref(single);
					const Tag = href ? 'a' : 'div';
					const iconClass = getCardIconClass(single);
					const imageSrc = iconClass ? '' : resolveImageSrc(single.immagine);

					return (
						<Tag class="cards_card" href={href || undefined}>
							{iconClass ? (
								<div class="cards_card_icon" aria-hidden="true">
									<i class={`fa-solid ${iconClass}`}></i>
								</div>
							) : imageSrc ? (
								<div class="cards_card_media">
									<img src={imageSrc} alt={single.titolo_card || ''} loading="lazy" />
								</div>
							) : null}
							{single.titolo_card && <h3 class="cards_card_title" set:html={single.titolo_card} />}
							{single.descrizione && <p class="cards_card_description" set:html={single.descrizione} />}
						</Tag>
					);
				})}
			</div>
		</div>
	</section>
)}

<style>
	.cards_block {
		width: 100%;
		margin: 0;
		padding: 64px 0;
		background: var(--lex-cream, #ddd);
	}

	.cards_block_inner {
		width: min(1240px, calc(100% - 40px));
		margin: 0 auto;
	}

	.cards_block_title {
		margin: 0 0 32px;
		color: #000;
		max-width: 780px;
		font-size: clamp(34px, 4vw, 52px);
		line-height: 1.05;
		letter-spacing: -.05em;
	}

	.cards_block_title :global(span) {
		padding-inline: .12em;
		border-radius: 6px;
		background: #00ec10;
		color: #000;
	}

	.cards_grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		margin-bottom: 0;
	}

	.cards_card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		min-width: 0;
		padding: 30px;
		background: #fbf7f5;
		border: 1px solid rgba(14,14,15,.1);
		border-radius: 30px;
		color: var(--lex-dark);
		transition: border-color 200ms ease, background 200ms ease;
		text-align: left;
		align-items: flex-start;
		overflow-wrap: anywhere;
	}

	a.cards_card:hover {
		border-color: #000;
		background: #fff;
	}
	a.cards_card:focus-visible { outline: 3px solid #000; outline-offset: 4px; }

	.cards_card_title {
		margin: 4px 0 0;
		font-size: 20px;
		line-height: 1.3;
		letter-spacing: -.03em;
	}

	.cards_card_description {
		margin: 4px 0 0;
		color: #5d5d63;
		font-size: 15px;
		line-height: 1.7;
	}

	.cards_card_media img {
		width: 84px;
		height: 84px;
		object-fit: contain;
	}

	.cards_card_icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		margin-bottom: 8px;
		background: transparent;
	}

	.cards_card_icon i {
		color: #00ec10;
		font-size: 38px;
	}

	.cards_block_compact_media .cards_card_media img {
		height: 120px;
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	@media (max-width: 1024px) {
		.cards_grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.cards_block {
			padding: 48px 0;
		}

		.cards_block_inner {
			width: calc(100% - 28px);
		}

		.cards_grid {
			grid-template-columns: 1fr;
		}
	}
</style>
